---
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/shop/PageBanner.astro';
import Listing from '../../components/shop/Listing.astro';
import { api } from '../../lib/api.ts';
import { getCommon } from '../../lib/content.ts';
import { listQuery } from '../../lib/listing.ts';
const { site, categories } = await getCommon();
const coll = (await api().catalog.collections()).find((c) => c.slug === Astro.params.slug);
if (!coll) return Astro.rewrite('/404');
const list = await api().catalog.products(listQuery(Astro.url, { collection: coll.slug }));
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=600');
---
<Base site={site} categories={categories} title={coll.name} description={coll.description || `Shop the ${coll.name} at Femia.`} image={coll.image?.src['1600']} noindex={Astro.url.search.length > 0}>
  <PageBanner eyebrow={coll.kind === 'occasion' ? 'Shop by occasion' : 'Collection'} title={coll.name} sub={coll.description} image={coll.image} />
  <Listing list={list} categories={categories} basePath={`/collections/${coll.slug}`} showTabs={false} />
</Base>
