---
import Base from '../layouts/Base.astro';
import Boutique from '../components/home/Boutique.astro';
import Icon from '../components/ui/Icon.astro';
import { getCommon } from '../lib/content.ts';
import { TRY_ON_ENABLED } from '../lib/features.ts';
const { site, categories } = await getCommon();
const s = site.settings.store;
const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const fmt = (hm: string) => { const [h, m] = hm.split(':').map(Number); const d = new Date(2000, 0, 1, h, m); return d.toLocaleTimeString('en-IN', { hour: 'numeric', minute: m ? '2-digit' : undefined, hour12: true }).toUpperCase(); };
const address = [s.address.line1, s.address.line2, s.address.city, s.address.state, s.address.pincode].filter(Boolean).join(', ');
// Exact pin when the owner set coordinates; otherwise Google finds the address.
const mapQuery = s.geo ? `${s.geo.lat},${s.geo.lng}` : [s.address.line1, s.address.line2, s.address.city, s.address.state].filter(Boolean).join(', ');
const mapEmbed = mapQuery ? `https://maps.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=16&output=embed` : null;
const tel = s.phone.replace(/[^\d+]/g, '');
const ld = { '@context': 'https://schema.org', '@type': 'ClothingStore', name: `${s.name} Boutique`, address, telephone: s.phone || undefined, openingHours: s.hoursSummary || undefined };
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300');
---
<Base site={site} categories={categories} title="Visit our boutique" description={`Visit ${s.name} at ${address}. ${s.hoursSummary}`} jsonLd={ld}>
  <Boutique block={{ ...site.content.boutique, eyebrow: 'Visit us' }} image={site.content.boutique?.image ? site.media[site.content.boutique.image] : undefined} store={s} headingLevel="h1" />
  <section class="section container visit">
    <div class="visit__info">
      <div class="visit__block"><h2 class="h3"><Icon name="pin" /> Address</h2><p>{address}</p>{s.mapUrl && <a class="link-arrow" href={s.mapUrl} target="_blank" rel="noopener">Open in Maps <Icon name="arrowRight" size={18} /></a>}</div>
      <div class="visit__block" id="hours">
        <h2 class="h3"><Icon name="clock" /> Hours</h2>
        {s.hours ? <table class="visit__hours"><tbody>{s.hours.map((h, i) => <tr><th scope="row">{days[i]}</th><td>{h.closed ? 'Closed' : `${fmt(h.open)} – ${fmt(h.close)}`}</td></tr>)}</tbody></table> : <p>{s.hoursSummary}</p>}
      </div>
      <div class="visit__block">
        <h2 class="h3"><Icon name="chat" /> Talk to us</h2>
        <div class="visit__ctas">
          {tel && <a class="btn btn--outline" href={`tel:${tel}`}><Icon name="phone" size={20} /> Call {s.phone}</a>}
          {s.whatsapp && <a class="btn btn--outline" href={`https://wa.me/${s.whatsapp.replace(/\D/g, '').replace(/^(\d{10})$/, '91$1')}`} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> WhatsApp</a>}
        </div>
      </div>
      {TRY_ON_ENABLED && s.whatsapp && (
        <div class="visit__block">
          <h2 class="h3"><Icon name="hanger" /> Try before you buy</h2>
          <p>Save pieces to a try-on list as you browse, choose a time, and send it to us on WhatsApp. We'll confirm before you come in.</p>
          <div class="visit__ctas"><button type="button" class="btn" data-ui="trial:open">Plan a try-on visit <Icon name="arrowRight" size={18} class="arrow" /></button></div>
        </div>
      )}
    </div>
    {mapEmbed && <div class="visit__map"><iframe title={`Map showing ${s.name} boutique`} src={mapEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>}
  </section>
</Base>
<style>
  .visit { display: grid; grid-template-columns: 1fr 1.2fr; gap: var(--sp-10); align-items: start; }
  .visit__info { display: grid; gap: var(--sp-8); }
  .visit__block { display: grid; gap: var(--sp-3); }
  .visit__block h2 { display: flex; align-items: center; gap: var(--sp-3); font-size: 1.625rem; }
  .visit__block h2 :global(svg) { color: var(--c-accent); }
  .visit__hours th { text-align: left; font-weight: 500; padding: 4px var(--sp-8) 4px 0; }
  .visit__ctas { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .visit__map { border-radius: var(--r-lg); overflow: hidden; aspect-ratio: 4 / 3; background: var(--c-sand); box-shadow: var(--shadow-card); }
  .visit__map iframe { width: 100%; height: 100%; border: 0; }
  @media (max-width: 899px) { .visit { grid-template-columns: 1fr; } }
</style>
