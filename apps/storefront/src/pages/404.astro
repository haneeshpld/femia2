---
import Base from '../layouts/Base.astro';
import { getCommon } from '../lib/content.ts';
import { t } from '@femia/i18n';
const { site, categories } = await getCommon();
Astro.response.status = 404;
---
<Base site={site} categories={categories} title="Page not found" noindex>
  <section class="nf container">
    <p class="nf__code" aria-hidden="true">404</p>
    <h1 class="h2">{t('error.404.title')}</h1>
    <p>{t('error.404.body')}</p>
    <div class="nf__ctas"><a class="btn" href="/shop?sort=new">Shop New Arrivals</a><a class="btn btn--outline" href="/">Go home</a></div>
  </section>
</Base>
<style>
  .nf { display: grid; justify-items: center; text-align: center; gap: var(--sp-4); padding-block: var(--sp-20); }
  .nf__code { font-family: var(--font-display); font-style: italic; font-size: clamp(6rem, 18vw, 11rem); line-height: .9; color: var(--c-maroon); opacity: .9; }
  .nf p:not(.nf__code) { max-width: 40ch; }
  .nf__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--sp-4); margin-top: var(--sp-4); }
</style>
