---
import Base from '../layouts/Base.astro';
import { getCommon } from '../lib/content.ts';
import { richText } from '../lib/format.ts';
const { site, categories } = await getCommon();
const g = site.content.sizeGuide ?? {};
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300');
---
<Base site={site} categories={categories} title="Size guide">
  <section class="section container" style="max-width: 820px">
    <h1 class="h2" style="margin-block: var(--sp-2) var(--sp-6)">Size guide</h1>
    <div class="prose" set:html={richText(g.chart ?? '')} />
    {g.howToMeasure && <><h2 class="h3" style="margin-top: var(--sp-10)">How to measure</h2><p style="margin-top: var(--sp-3)">{g.howToMeasure}</p></>}
    <p style="margin-top: var(--sp-8)">Not sure? <a href="/visit" style="color: var(--c-maroon); text-decoration: underline">Visit the boutique</a> or message us on WhatsApp and we'll help you choose.</p>
  </section>
</Base>
