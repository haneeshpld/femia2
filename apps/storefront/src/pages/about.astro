---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/shop/PageBanner.astro';
import { getCommon } from '../lib/content.ts';
import { richText } from '../lib/format.ts';
const { site, categories } = await getCommon();
const a = site.content.about ?? {};
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300');
---
<Base site={site} categories={categories} title="About" description={a.intro}>
  <PageBanner eyebrow="Our story" title={a.title ?? 'About Femia'} image={a.image ? site.media[a.image] : null} />
  <section class="section container about">
    {a.intro && <p class="about__intro">{a.intro}</p>}
    <div class="prose" set:html={richText(a.body ?? '')} />
    <div class="about__ctas"><a class="btn" href="/shop">Shop the collection</a><a class="btn btn--outline" href="/visit">Visit the boutique</a></div>
  </section>
</Base>
<style>
  .about { max-width: 820px; }
  .about__intro { font-family: var(--font-display); font-size: var(--fs-xl); line-height: 1.3; color: var(--c-ink); margin-bottom: var(--sp-8); }
  .about__ctas { display: flex; flex-wrap: wrap; gap: var(--sp-4); margin-top: var(--sp-10); }
</style>
