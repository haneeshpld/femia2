---
import Base from '../layouts/Base.astro';
import Checkout from '../components/islands/Checkout.tsx';
import '../components/islands/checkout.css';
import { getCommon } from '../lib/content.ts';
import { t } from '@femia/i18n';
import { freeShippingText } from '../lib/format.ts';
const { site, categories } = await getCommon();
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Base site={site} categories={categories} title={t('checkout.title')} noindex minimal>
  <section class="container checkout">
    <h1 class="h2">{t('checkout.title')}</h1>
    <p class="muted">No account needed. We deliver within Kerala. {freeShippingText(site.settings.shipping)}.</p>
    <Checkout client:load payments={site.settings.payments} />
  </section>
</Base>
<style>
  .checkout { padding-block: var(--sp-8) var(--sp-16); }
  .checkout > .muted { margin: var(--sp-2) 0 var(--sp-8); font-size: .9375rem; }
  @media (max-width: 1023px) {
    .checkout { padding-block: var(--sp-5) var(--sp-6); }
    .checkout > h1 { font-size: 1.75rem; }
    .checkout > .muted { margin: 2px 0 var(--sp-4); font-size: .8125rem; }
  }
</style>
