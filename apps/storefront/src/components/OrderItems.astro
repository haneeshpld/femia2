---
import type { PublicOrder } from '@femia/contracts';
import { formatINR } from '@femia/contracts';
interface Props { order: PublicOrder }
const { order: o } = Astro.props;
---
<ul role="list" class="oi">
  {o.items.map((i) => (
    <li>
      <span class="oi__img">{i.imageUrl && <img src={i.imageUrl} alt="" width="64" height="85" loading="lazy" />}</span>
      <span class="oi__info"><strong>{i.title}</strong><span class="muted">{i.optionLabel} · Qty {i.qty}</span></span>
      <span class="oi__price">{formatINR(i.lineTotal)}</span>
    </li>
  ))}
</ul>
<dl class="oi__totals">
  <div><dt>Subtotal</dt><dd>{formatINR(o.subtotal)}</dd></div>
  <div><dt>Shipping</dt><dd>{o.shipping ? formatINR(o.shipping) : 'Free'}</dd></div>
  <div class="oi__grand"><dt>Total</dt><dd>{formatINR(o.total)}</dd></div>
</dl>
<style>
  .oi { display: grid; gap: var(--sp-3); }
  .oi li { display: grid; grid-template-columns: 64px 1fr auto; gap: var(--sp-4); align-items: center; }
  .oi__img { width: 64px; aspect-ratio: 3/4; border-radius: var(--r-sm); overflow: hidden; background: var(--c-sand); }
  .oi__img img { width: 100%; height: 100%; object-fit: cover; }
  .oi__info { display: grid; }
  .oi__info strong { font-family: var(--font-display); font-size: 1.125rem; color: var(--c-ink); }
  .oi__info .muted { font-size: .875rem; }
  .oi__price { font-weight: 600; color: var(--c-ink); }
  .oi__totals { display: grid; gap: var(--sp-1); margin-top: var(--sp-5); padding-top: var(--sp-4); border-top: 1px solid var(--c-line); }
  .oi__totals div { display: flex; justify-content: space-between; }
  .oi__totals dt { color: var(--c-muted); }
  .oi__grand { font-size: 1.125rem; font-weight: 700; color: var(--c-ink); }
  .oi__grand dt { color: var(--c-ink) !important; }
</style>
