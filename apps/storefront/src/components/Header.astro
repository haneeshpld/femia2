---
import Icon from './ui/Icon.astro';
import Logo from './ui/Logo.astro';
import { t } from '@femia/i18n';
const path = Astro.url.pathname;
type Item = { href: string; label: string; active: boolean };
const left: Item[] = [
  { href: '/', label: t('nav.home'), active: path === '/' },
  { href: '/shop', label: t('nav.shop'), active: path.startsWith('/shop') || path.startsWith('/products') },
];
const right: Item[] = [
  { href: '/collections', label: t('nav.collections'), active: path.startsWith('/collections') },
  { href: '/visit', label: t('nav.visit'), active: path.startsWith('/visit') },
];
---
<header class="hdr" data-header>
  <!-- Cream plate that dips into a shallow arch beneath the logo, edged with a zari thread. Shape is drawn by script. -->
  <div class="hdr__plate" aria-hidden="true"><div class="hdr__bg" data-hdr-bg></div></div>
  <svg class="hdr__thread" aria-hidden="true" data-hdr-thread>
    <path data-thread-half pathLength="1" />
    <path data-thread-half pathLength="1" />
  </svg>

  <div class="container hdr__inner">
    <button class="icon-btn hdr__m-only" type="button" data-ui="search:open" aria-label={t('nav.search')}><Icon name="search" /></button>
    <nav class="hdr__nav hdr__nav--l" aria-label="Main">
      <ul role="list">
        {left.map((n) => (
          <li><a href={n.href} aria-current={n.active ? 'page' : undefined}><span class="roll-txt"><span>{n.label}</span><span aria-hidden="true">{n.label}</span></span></a></li>
        ))}
      </ul>
    </nav>

    <a href="/" class="hdr__brand" aria-label="Femia home" data-hdr-brand><Logo /></a>

    <div class="hdr__right">
      <nav class="hdr__nav hdr__nav--r" aria-label="Collections and boutique">
        <ul role="list">
          {right.map((n) => (
            <li><a href={n.href} aria-current={n.active ? 'page' : undefined}><span class="roll-txt"><span>{n.label}</span><span aria-hidden="true">{n.label}</span></span></a></li>
          ))}
        </ul>
      </nav>
      <div class="hdr__actions">
        <button class="icon-btn hdr__d-only" type="button" data-ui="search:open" aria-label={t('nav.search')}><Icon name="search" /></button>
        <a class="icon-btn" href="/wishlist" aria-label={t('nav.wishlist')}>
          <Icon name="heart" /><span class="badge" data-wish-count hidden></span>
        </a>
        <button class="icon-btn" type="button" data-ui="cart:open" aria-label={t('nav.bag')} data-bag-button>
          <Icon name="bag" /><span class="badge" data-cart-count hidden></span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .hdr {
    --h-open: 92px; --h-closed: 64px; --dip-open: 20px;
    --hdr-h: var(--h-open); --dip: var(--dip-open); --brand-s: 1;
    position: sticky; top: 0; z-index: 40; height: var(--hdr-h);
    /* Constant layout height while the header slims: no content jump on scroll. */
    margin-bottom: calc(var(--h-open) - var(--hdr-h));
  }
  .hdr__plate { position: absolute; inset: 0 0 auto 0; height: calc(var(--hdr-h) + var(--dip) + 2px); pointer-events: none; filter: drop-shadow(0 10px 18px rgba(74, 20, 22, var(--shade, 0))); }
  .hdr__bg { position: absolute; inset: 0; background: color-mix(in srgb, var(--c-cream) 88%, transparent); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); }
  .hdr__thread { position: absolute; left: 0; top: 0; width: 100%; height: calc(var(--hdr-h) + var(--dip) + 4px); overflow: visible; pointer-events: none; }
  .hdr__thread path { fill: none; stroke: var(--c-zari); stroke-width: 1; stroke-linecap: round; }
  :global(.motion) .hdr__thread path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: thread-out 1.6s .25s cubic-bezier(.65, 0, .35, 1) forwards; }
  @keyframes thread-out { to { stroke-dashoffset: 0; } }

  .hdr__inner { position: relative; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 100%; gap: var(--sp-6); }
  .hdr__brand { justify-self: center; display: block; transform: translateY(calc(var(--dip) * .35)) scale(var(--brand-s)); transform-origin: 50% 50%; }
  .hdr__right { display: flex; align-items: center; justify-content: flex-end; gap: clamp(var(--sp-5), 3vw, var(--sp-10)); }
  .hdr__nav ul { display: flex; gap: clamp(var(--sp-5), 3vw, var(--sp-10)); }
  .hdr__nav a { position: relative; display: inline-flex; align-items: center; min-height: 44px; color: var(--c-ink); transition: color var(--motion-fast) ease; }
  /* Label rolls up to reveal the same word in Bodoni italic. */
  .roll-txt { display: inline-block; height: 1.5em; overflow: hidden; line-height: 1.5em; text-align: center; }
  .roll-txt > span { display: block; transition: transform 520ms var(--motion-ease-out); }
  .roll-txt > span:first-child { font-size: .76rem; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; }
  .roll-txt > span:last-child { font-family: var(--font-display); font-style: italic; font-size: 1.125rem; font-weight: 450; letter-spacing: -0.01em; color: var(--c-maroon); }
  .hdr__nav a:hover .roll-txt > span, .hdr__nav a:focus-visible .roll-txt > span { transform: translateY(-100%); }
  .hdr__nav a::before { content: ''; position: absolute; left: 50%; bottom: 4px; width: 6px; height: 6px; background: var(--c-zari); transform: translateX(-50%) rotate(45deg) scale(0); transition: transform 320ms var(--motion-ease-out); }
  .hdr__nav a[aria-current='page'] { color: var(--c-maroon); }
  .hdr__nav a[aria-current='page']::before { transform: translateX(-50%) rotate(45deg) scale(1); }
  .hdr__actions { display: flex; gap: var(--sp-1); margin-right: -10px; }
  .hdr__actions :global(.badge) { overflow: hidden; }
  .hdr__actions :global(.roll) { display: flex; flex-direction: column; line-height: 18px; }
  .hdr__actions :global(.roll span) { display: block; height: 18px; }
  .hdr__m-only { display: none; }

  @media (max-width: 1023px) {
    .hdr { --h-open: 72px; --h-closed: 58px; --dip-open: 14px; }
    .hdr__nav { display: none; }
    .hdr__m-only { display: inline-grid; margin-left: -10px; justify-self: start; }
    .hdr__d-only { display: none; }
    .hdr__inner { grid-template-columns: 1fr auto 1fr; }
  }
  @media print { .hdr { position: static; } }
</style>

<script>
  import { $cartCount, $wishlist } from '../lib/stores.ts';
  import { emit } from '../lib/ui-events.ts';

  // ── Masthead: slims, flattens its arch and tucks the logo in as you scroll ──
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const bg = header.querySelector<HTMLElement>('[data-hdr-bg]')!;
    const brand = header.querySelector<HTMLElement>('[data-hdr-brand]')!;
    const [lh, rh] = header.querySelectorAll<SVGPathElement>('[data-thread-half]');
    const num = (v: string) => parseFloat(getComputedStyle(header).getPropertyValue(v));
    let start = 0, hOpen = 92, hClosed = 64, dOpen = 20, last = -1;

    const measure = () => {
      hOpen = num('--h-open'); hClosed = num('--h-closed'); dOpen = num('--dip-open');
      // Progress starts once the announcement bar has scrolled away and the header is pinned.
      start = document.querySelector<HTMLElement>('.announce')?.offsetHeight ?? 0;
      last = -1; update();
    };
    const update = () => {
      const p = Math.min(1, Math.max(0, (scrollY - start) / 140));
      if (p === last) return;
      last = p;
      const e = 1 - Math.pow(1 - p, 3); // ease-out so it settles softly
      const h = hOpen + (hClosed - hOpen) * e;
      const d = dOpen * (1 - e);
      header.style.setProperty('--hdr-h', `${h}px`);
      header.style.setProperty('--dip', `${d}px`);
      header.style.setProperty('--brand-s', String(1 - 0.14 * e));
      header.style.setProperty('--shade', String(0.18 * e));
      const W = header.clientWidth;
      const b = brand.getBoundingClientRect(), hr = header.getBoundingClientRect();
      const cx = b.left - hr.left + b.width / 2;
      const a = Math.max(70, b.width / 2 + 44);
      const y = h, yd = h + d;
      // Plate: full width, bottom edge dips in a soft arch under the logo.
      bg.style.clipPath = `path('M0 0 H${W} V${y} H${cx + a} C${cx + a * 0.55} ${y}, ${cx + a * 0.5} ${yd}, ${cx} ${yd} C${cx - a * 0.5} ${yd}, ${cx - a * 0.55} ${y}, ${cx - a} ${y} H0 Z')`;
      lh?.setAttribute('d', `M${cx} ${yd} C${cx - a * 0.5} ${yd}, ${cx - a * 0.55} ${y}, ${cx - a} ${y} H0`);
      rh?.setAttribute('d', `M${cx} ${yd} C${cx + a * 0.5} ${yd}, ${cx + a * 0.55} ${y}, ${cx + a} ${y} H${W}`);
      header.classList.toggle('is-scrolled', p > 0.02);
    };
    let raf = 0;
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; update(); }); }, { passive: true });
    new ResizeObserver(measure).observe(header);
    document.fonts?.ready.then(measure);
    measure();
  }

  // ── Badges ──
  const setBadge = (el: Element | null, n: number) => { if (el instanceof HTMLElement) { el.hidden = n === 0; el.textContent = String(n); } };
  let shown = -1;
  const rollBadge = (el: Element | null, n: number) => {
    if (!(el instanceof HTMLElement)) return;
    const prev = shown; shown = n;
    el.hidden = n === 0;
    if (prev <= 0 || prev === n || n === 0 || matchMedia('(prefers-reduced-motion: reduce)').matches) { el.textContent = String(n); return; }
    const up = n > prev;
    el.innerHTML = `<span class="roll"><span>${up ? prev : n}</span><span>${up ? n : prev}</span></span>`;
    // Delay ≈ the photo's flight, so the number changes as it lands in the bag.
    (el.firstElementChild as HTMLElement).animate(
      [{ transform: `translateY(${up ? '0' : '-50%'})` }, { transform: `translateY(${up ? '-50%' : '0'})` }],
      { duration: 420, delay: up ? 900 : 0, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'both' },
    ).onfinish = () => { if (shown === n) el.textContent = String(n); };
  };
  $cartCount.subscribe((n) => {
    rollBadge(document.querySelector('[data-cart-count]'), n);
    document.querySelector('[data-bag-button]')?.setAttribute('aria-label', n ? `Bag, ${n} items` : 'Bag');
  });
  $wishlist.subscribe((w) => setBadge(document.querySelector('[data-wish-count]'), w.length));
  document.addEventListener('click', (e) => {
    const el = (e.target as Element).closest<HTMLElement>('[data-ui]');
    if (!el) return;
    e.preventDefault();
    emit({ type: el.dataset.ui as 'cart:open' | 'search:open' });
  });
</script>
