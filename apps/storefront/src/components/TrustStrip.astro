---
import Icon from './ui/Icon.astro';
import type { IconName } from '../lib/icons.ts';
interface Props { items: { icon: string; title: string; body: string }[] }
const { items } = Astro.props;
const map: Record<string, IconName> = { truck: 'truck', returns: 'returns', shield: 'shield', chat: 'chat', heart: 'heart' };
---
{items.length > 0 && (
  <section class="container trust" aria-label="Why shop with us">
    <ul role="list" class="trust__list">
      {items.map((it) => (
        <li class="trust__item">
          <Icon name={map[it.icon] ?? 'sparkle'} size={34} />
          <div><strong>{it.title}</strong><span>{it.body}</span></div>
        </li>
      ))}
    </ul>
  </section>
)}
<style>
  .trust { padding-block: var(--sp-8); }
  .trust__list { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--c-line); padding-top: var(--sp-8); }
  .trust__item { display: flex; align-items: center; justify-content: center; gap: var(--sp-4); color: var(--c-ink); padding-inline: var(--sp-4); }
  .trust__item + .trust__item { border-left: 1px solid var(--c-line); }
  .trust__item div { display: grid; line-height: 1.35; }
  .trust__item strong { font-weight: 600; }
  .trust__item span { color: var(--c-muted); font-size: .9375rem; }
  @media (max-width: 899px) {
    .trust__list { grid-template-columns: 1fr 1fr; row-gap: var(--sp-6); }
    .trust__item { justify-content: flex-start; padding-inline: var(--sp-3); }
    .trust__item:nth-child(odd) { border-left: 0; }
  }
  @media (max-width: 380px) { .trust__item { gap: var(--sp-3); } .trust__item :global(svg) { width: 28px; height: 28px; } }
</style>
