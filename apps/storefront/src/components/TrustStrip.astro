---
/**
 * The boutique's promises, as one quiet line above the footer: each title and its detail, separated by fine gold
 * hairlines. (Premium pass: the icon band was retired.) Phones: a 2×2 grid of short lines.
 */
interface Props { items: { icon: string; title: string; body: string }[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="container trust" aria-label="Why shop with us">
    <ul role="list" class="trust__list">
      {items.map((it) => <li class="trust__item"><strong>{it.title}</strong> <span>{it.body}</span></li>)}
    </ul>
  </section>
)}
<style>
  .trust { padding-block: clamp(var(--sp-6), 3vw, var(--sp-10)) 0; }
  .trust__list { display: flex; justify-content: center; flex-wrap: wrap; padding-block: var(--sp-6); border-top: 1px solid var(--c-line); }
  .trust__item { padding-inline: clamp(var(--sp-5), 3vw, var(--sp-10)); font-size: .9375rem; color: var(--c-muted); text-align: center; }
  .trust__item + .trust__item { border-left: 1px solid rgba(200, 165, 116, .55); }
  .trust__item strong { font-weight: 500; color: var(--c-ink); }
  @media (max-width: 767px) {
    .trust__list { display: grid; grid-template-columns: 1fr 1fr; row-gap: var(--sp-4); }
    .trust__item { display: grid; gap: 2px; padding-inline: var(--sp-3); font-size: .875rem; }
    .trust__item:nth-child(odd) { border-left: 0; }
  }
</style>
