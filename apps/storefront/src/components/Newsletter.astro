---
import Icon from './ui/Icon.astro';
import { t } from '@femia/i18n';
interface Props { title: string; body: string }
const { title, body } = Astro.props;
const subscribed = Astro.url.searchParams.get('subscribed') === '1';
---
<section class="newsletter" aria-labelledby="nl-title">
  <svg class="wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60V28C240 4 480 0 720 14s480 34 720 10v36Z" fill="currentColor"/></svg>
  <div class="container newsletter__inner">
    <div class="newsletter__copy">
      <span class="newsletter__icon"><Icon name="mail" size={28} /></span>
      <div>
        <h2 id="nl-title" class="newsletter__title">{title}</h2>
        <p>{body}</p>
      </div>
    </div>
    <form class="newsletter__form" method="post" action="/newsletter" data-newsletter novalidate>
      <label for="nl-email" class="sr-only">Email address</label>
      <input id="nl-email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder={t('home.newsletter.placeholder')} />
      <button type="submit" class="btn btn--light">{t('home.newsletter.cta')}</button>
      <p class="newsletter__msg" role="status" aria-live="polite" data-msg>{subscribed ? t('home.newsletter.thanks') : ''}</p>
    </form>
  </div>
</section>
<style>
  .newsletter { position: relative; background: var(--c-maroon); color: var(--c-cream); margin-top: var(--sp-10); }
  .wave { position: absolute; left: 0; right: 0; bottom: calc(100% - 1px); width: 100%; height: clamp(24px, 4vw, 56px); color: var(--c-maroon); }
  .newsletter__inner { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: var(--sp-10); padding-block: var(--sp-10); }
  .newsletter__copy { display: flex; align-items: center; gap: var(--sp-6); padding-right: var(--sp-10); border-right: 1px solid rgba(251, 241, 233, .25); }
  .newsletter__icon { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; border: 1.5px solid rgba(251, 241, 233, .7); flex: none; }
  .newsletter__title { font-style: italic; color: var(--c-white); font-size: var(--fs-xl); font-weight: 500; }
  .newsletter p { opacity: .9; }
  .newsletter__form { position: relative; display: flex; align-items: center; width: min(440px, 100%); border: 1.5px solid rgba(251, 241, 233, .8); border-radius: var(--r-pill); padding: 4px; }
  .newsletter__form input { flex: 1; min-width: 0; min-height: 46px; background: transparent; border: 0; padding: 0 var(--sp-5); color: var(--c-white); font-size: 16px; }
  .newsletter__form input::placeholder { color: rgba(251, 241, 233, .8); }
  .newsletter__form input:focus { outline: none; }
  .newsletter__form:focus-within { box-shadow: 0 0 0 3px rgba(251, 241, 233, .35); }
  .newsletter__msg { position: absolute; top: calc(100% + 8px); left: var(--sp-5); font-size: .875rem; }
  @media (max-width: 899px) {
    .newsletter__inner { grid-template-columns: 1fr; text-align: center; justify-items: center; gap: var(--sp-6); padding-block: var(--sp-10) var(--sp-12); }
    .newsletter__copy { flex-direction: column; border: 0; padding: 0; gap: var(--sp-4); }
    .newsletter__form { flex-direction: column; border: 0; padding: 0; gap: var(--sp-3); }
    .newsletter__form input { width: 100%; border: 1.5px solid rgba(251, 241, 233, .8); border-radius: var(--r-pill); }
    .newsletter__form .btn { width: 100%; }
    .newsletter__msg { position: static; }
  }
</style>
<script>
  import { t } from '@femia/i18n';
  import { track } from '../lib/analytics.ts';
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector<HTMLElement>('[data-msg]')!;
      const input = form.querySelector('input')!;
      if (!input.checkValidity()) { msg.textContent = t('home.newsletter.error'); input.focus(); return; }
      const btn = form.querySelector('button')!;
      btn.disabled = true;
      try {
        const res = await fetch('/api/newsletter', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: input.value, source: 'footer' }) });
        if (!res.ok) throw new Error();
        msg.textContent = t('home.newsletter.thanks'); form.reset(); track('newsletter_signup');
      } catch { msg.textContent = t('home.newsletter.error'); }
      btn.disabled = false;
    });
  });
</script>
