---
interface Props { messages: { text: string; link?: string }[] }
const { messages } = Astro.props;
---
{messages.length > 0 && (
  <div class="announce" role="region" aria-label="Announcements">
    <ul class="sr-only">{messages.map((m) => <li>{m.link ? <a href={m.link}>{m.text}</a> : m.text}</li>)}</ul>
    <!-- One message at a time, centred; several messages take turns with a soft fade. -->
    <div class="announce__rot container" aria-hidden="true" data-announce>
      {messages.map((m, i) => (
        <p class="announce__msg" data-on={i === 0 ? '' : undefined}>
          {m.link ? <a href={m.link} tabindex="-1">{m.text}</a> : m.text}
        </p>
      ))}
    </div>
  </div>
)}
<style>
  .announce { position: relative; background: var(--c-blush); color: var(--c-ink); font-size: .8125rem; font-weight: 500; letter-spacing: .02em; line-height: 1.4; }
  .announce__rot { display: grid; align-items: center; min-height: 38px; padding-block: 8px; text-align: center; }
  .announce__msg { grid-area: 1 / 1; display: flex; align-items: center; justify-content: center; gap: var(--sp-4); opacity: 0; visibility: hidden; transition: opacity 600ms ease, visibility 0s linear 600ms; }
  .announce__msg[data-on] { opacity: 1; visibility: visible; transition: opacity 600ms ease, visibility 0s; }
  /* fine caramel rules either side of the message */
  .announce__msg::before, .announce__msg::after { content: ''; flex: none; width: clamp(20px, 6vw, 64px); height: 1px; background: linear-gradient(90deg, transparent, var(--c-zari-deep)); opacity: .7; }
  .announce__msg::after { transform: scaleX(-1); }
  .announce a { text-decoration: underline; text-decoration-color: var(--c-zari); text-underline-offset: 3px; }
  .announce a:hover { text-decoration-color: currentColor; }
</style>
<script>
  // The bar persists across page changes, so this runs once.
  const rot = document.querySelector<HTMLElement>('[data-announce]');
  const items = rot ? [...rot.querySelectorAll<HTMLElement>('.announce__msg')] : [];
  if (rot && items.length > 1) {
    let i = 0, paused = false;
    rot.addEventListener('pointerenter', () => (paused = true));
    rot.addEventListener('pointerleave', () => (paused = false));
    setInterval(() => {
      if (paused || document.hidden) return;
      items[i]!.removeAttribute('data-on');
      i = (i + 1) % items.length;
      items[i]!.setAttribute('data-on', '');
    }, 5000);
  }
</script>
