---
interface Props { messages: { text: string; link?: string }[] }
const { messages } = Astro.props;
---
{messages.length > 0 && (
  <div class="announce" role="region" aria-label="Announcements">
    <div class="container announce__inner">
      {messages.map((m, i) => (
        <>
          {i > 0 && <span class="announce__sep" aria-hidden="true">|</span>}
          {m.link ? <a href={m.link} class:list={['announce__msg', { 'announce__msg--extra': i > 0 }]}>{m.text}</a>
                  : <span class:list={['announce__msg', { 'announce__msg--extra': i > 0 }]}>{m.text}</span>}
        </>
      ))}
    </div>
  </div>
)}
<style>
  .announce { background: var(--c-maroon); color: var(--c-white); font-size: .75rem; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; }
  .announce__inner { display: flex; align-items: center; justify-content: center; gap: var(--sp-5); min-height: 40px; text-align: center; }
  .announce a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .announce__sep { opacity: .6; }
  @media (max-width: 767px) {
    .announce { letter-spacing: .16em; }
    .announce__sep, .announce__msg--extra { display: none; }
  }
</style>
