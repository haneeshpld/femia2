---
import Icon from './ui/Icon.astro';
import { t } from '@femia/i18n';
const p = Astro.url.pathname;
const tabs = [
  { href: '/', icon: 'home', label: t('nav.home'), active: p === '/' },
  { href: '/shop', icon: 'bag', label: t('nav.shop'), active: p.startsWith('/shop') || p.startsWith('/products') },
  { href: '/collections', icon: 'layers', label: t('nav.collections'), active: p.startsWith('/collections') },
  { href: '/visit', icon: 'pin', label: t('nav.visit'), active: p.startsWith('/visit') },
] as const;
---
<nav class="tabbar" aria-label="Main">
  {tabs.map((tab) => (
    <a href={tab.href} aria-current={tab.active ? 'page' : undefined}><Icon name={tab.icon} size={22} /><span>{tab.label}</span></a>
  ))}
</nav>
<style>
  .tabbar { display: none; }
  @media (max-width: 767px) {
    .tabbar {
      position: fixed; inset: auto 0 0 0; z-index: 45; display: grid; grid-template-columns: repeat(4, 1fr);
      background: color-mix(in srgb, var(--c-cream) 94%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid var(--c-line); padding-bottom: env(safe-area-inset-bottom);
    }
    .tabbar a { display: grid; justify-items: center; gap: 2px; padding: 8px 0 6px; min-height: 56px; font-size: .75rem; color: var(--c-muted); }
    .tabbar a[aria-current='page'] { color: var(--c-maroon); font-weight: 600; }
  }
</style>
