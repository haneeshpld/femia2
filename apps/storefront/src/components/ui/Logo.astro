---
interface Props { variant?: 'dark' | 'light'; size?: 'md' | 'lg' }
const { variant = 'dark', size = 'md' } = Astro.props;
const h = size === 'lg' ? 44 : 34;
const wm = variant === 'light' ? '/brand/wordmark-light' : '/brand/wordmark';
---
<span class:list={['logo', `logo--${size}`]}>
  <img src="/brand/emblem.webp" alt="" width={h + 8} height={h + 8} class="logo__emblem" />
  <picture>
    <source srcset={`${wm}.webp`} type="image/webp" />
    <img src={`${wm}.png`} alt="Femia" width={Math.round(h * 2.04)} height={h} class="logo__word" />
  </picture>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: .55rem; }
  .logo__emblem { width: auto; height: calc(var(--h) + 8px); }
  .logo__word { width: auto; }
  .logo--md { --h: 34px; } .logo--lg { --h: 44px; }
  .logo__word { height: var(--h); }
  @media (max-width: 767px) { .logo--md { --h: 28px; } }
</style>
