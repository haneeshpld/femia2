---
import { ICONS, type IconName } from '../../lib/icons.ts';
interface Props { name: IconName; size?: number; class?: string; label?: string; filled?: boolean }
const { name, size = 24, class: cls, label, filled = false } = Astro.props;
---
<svg
  class:list={['icon', cls]}
  width={size} height={size} viewBox="0 0 24 24" fill={filled ? 'currentColor' : 'none'} stroke="currentColor"
  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}
  set:html={ICONS[name]}
/>
