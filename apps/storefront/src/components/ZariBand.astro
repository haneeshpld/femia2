---
/** Woven gold zari hem: crisp vector geometry (lozenges, arches, seed dots) like an embroidered kurta border. */
interface Props { tone?: 'maroon' | 'cream' }
const { tone = 'maroon' } = Astro.props;
const id = `zari-${tone}`;
---
<div class:list={['zari', `zari--${tone}`]} aria-hidden="true" data-zari>
  <svg width="100%" height="100%" preserveAspectRatio="none">
    <defs>
      <pattern id={id} width="64" height="48" patternUnits="userSpaceOnUse">
        <g fill="none" stroke="currentColor" stroke-width="1">
          <path d="M0 6.5H64M0 9.5H64M0 38.5H64M0 41.5H64" />
          <path d="M16 15 L24 24 L16 33 L8 24 Z" />
          <path d="M47 32 V24 A6 6 0 0 1 59 24 V32 Z" transform="translate(-6 0)" />
        </g>
        <g fill="currentColor">
          <path d="M16 20 L20 24 L16 28 L12 24 Z" />
          <circle cx="32" cy="24" r="1.4" />
          <circle cx="0" cy="24" r="1.4" />
          <circle cx="64" cy="24" r="1.4" />
          <circle cx="47" cy="27.5" r="1.3" />
        </g>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${id})`} data-zari-weave />
  </svg>
</div>
<style>
  .zari { position: relative; height: 48px; overflow: hidden; }
  .zari--maroon { background: var(--c-maroon-900); color: var(--c-zari); }
  .zari--cream { background: var(--c-cream); color: var(--c-zari-deep); }
  .zari svg { display: block; }
  .zari::after { /* light catching the thread */
    content: ''; position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen;
    background: linear-gradient(100deg, transparent 35%, rgba(255, 228, 170, .45) 50%, transparent 65%) -60% 0 / 60% 100% no-repeat;
    animation: zari-glint 7s linear infinite;
  }
  .zari:not(.is-visible)::after { animation-play-state: paused; }
  @keyframes zari-glint { to { background-position: 160% 0; } }
</style>
