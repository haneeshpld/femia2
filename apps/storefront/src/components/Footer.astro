---
import Icon from './ui/Icon.astro';
import Logo from './ui/Logo.astro';
import type { PublicSettings, Category } from '@femia/contracts';
import { boutiqueStatus } from '../lib/hours.ts';
import { t } from '@femia/i18n';

interface Props { settings: PublicSettings; categories: Category[]; newsletter: { title?: string; body?: string }; minimal?: boolean }
const { settings, categories, newsletter, minimal = false } = Astro.props;
const s = settings.store;
const wa = s.whatsapp ? `https://wa.me/${s.whatsapp.replace(/\D/g, '').replace(/^(\d{10})$/, '91$1')}` : null;
const tel = s.phone.replace(/[^\d+]/g, '');
const status = boutiqueStatus(s.hours);
const place = [s.address.line1, s.address.line2, s.address.city].filter(Boolean).join(', ');
const subscribed = Astro.url.searchParams.get('subscribed') === '1';
---
<footer class="ft" data-footer>
  <div class:list={['container ft__grid', { 'ft__grid--minimal': minimal }]}>
    <div class="ft__brand">
      <a href="/" class="ft__logo" aria-label={`${s.name} home`}><Logo size="lg" variant="light" /></a>
      <p class="ft__tagline">{s.tagline}</p>
      {status ? (
        <a class:list={['ft__status', { 'is-open': status.open }]} href="/visit" data-hours={JSON.stringify(s.hours)}><span class="ft__dot" aria-hidden="true"></span><span><span data-status-text>{status.text}</span>{place && <span class="ft__place"> · {place}</span>}</span></a>
      ) : s.hoursSummary && <a class="ft__status" href="/visit"><span>{s.hoursSummary}</span></a>}
      <div class="ft__social">
        {s.socials.instagram && <a class="ft__icon" href={s.socials.instagram} rel="noopener" target="_blank" aria-label="Instagram"><Icon name="instagram" size={20} /></a>}
        {wa && <a class="ft__icon" href={wa} rel="noopener" target="_blank" aria-label="WhatsApp"><Icon name="whatsapp" size={20} /></a>}
        {s.socials.whatsappGroup && <a class="ft__icon" href={s.socials.whatsappGroup} rel="noopener" target="_blank" aria-label="Join our WhatsApp group"><Icon name="chat" size={20} /></a>}
        {tel && <a class="ft__icon" href={`tel:${tel}`} aria-label={`Call ${s.phone}`}><Icon name="phone" size={20} /></a>}
      </div>
    </div>

    <nav class="ft__links" aria-label="Footer">
      <div><h2 class="ft__h">{t('footer.shop')}</h2><ul role="list">{categories.map((c) => <li><a href={`/shop/${c.slug}`}>{c.name}</a></li>)}<li><a href="/collections">Collections</a></li></ul></div>
      <div><h2 class="ft__h">{t('footer.help')}</h2><ul role="list"><li><a href="/track">Track your order</a></li><li><a href="/policies/shipping">Shipping</a></li><li><a href="/policies/returns">Returns</a></li><li><a href="/size-guide">Size guide</a></li><li><a href="/policies/contact">Contact</a></li></ul></div>
      <div><h2 class="ft__h">About</h2><ul role="list"><li><a href="/about">Our story</a></li><li><a href="/visit">Visit the boutique</a></li>{s.mapUrl && <li><a href={s.mapUrl} target="_blank" rel="noopener">Directions</a></li>}<li><a href="/wishlist">Wishlist</a></li></ul></div>
    </nav>

    {!minimal && (
      <section class="ft__letters" aria-labelledby="nl-title">
        <h2 id="nl-title" class="ft__h">{newsletter.title || 'Get Style Updates'}</h2>
        {newsletter.body && <p class="ft__nl-body">{newsletter.body}</p>}
        <form class="ft__form" method="post" action="/newsletter" data-newsletter novalidate>
          <label for="nl-email" class="sr-only">Email address</label>
          <input id="nl-email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder={t('home.newsletter.placeholder')} />
          <button type="submit" class="ft__send" aria-label={t('home.newsletter.cta')}><Icon name="arrowRight" size={18} /></button>
        </form>
        <p class="ft__msg" role="status" aria-live="polite" data-msg>{subscribed ? t('home.newsletter.thanks') : ''}</p>
      </section>
    )}
  </div>

  <div class="container ft__base">
    <p>{t('footer.rights', { year: new Date().getFullYear(), name: s.name })}<span class="ft__sep" aria-hidden="true">|</span>{[s.address.city, s.address.state || 'Kerala'].filter(Boolean).join(', ')}</p>
    <p><a href="/policies/privacy">Privacy</a><span class="ft__sep" aria-hidden="true">|</span><a href="/policies/terms">Terms</a><span class="ft__sep" aria-hidden="true">|</span><a href="/policies/returns">Refund policy</a></p>
  </div>
</footer>

<style>
  /* Rosewood footer: the shared tokens are re-mapped to light-on-dark here, so every part below follows. */
  .ft {
    --c-ink: #FBF1EC; --c-text: rgba(251, 241, 236, .84); --c-muted: rgba(251, 241, 236, .64); --c-line: rgba(230, 207, 164, .22);
    --c-accent: #EDC0B0; --c-surface: rgba(255, 255, 255, .07);
    position: relative; background: var(--grad-footer); color: var(--c-ink); margin-top: clamp(var(--sp-10), 4vw, var(--sp-16));
    border-top: 1px solid rgba(200, 165, 116, .5);
  }
  .ft__grid { display: grid; grid-template-columns: 1.25fr 2.4fr 1.35fr; gap: clamp(var(--sp-8), 4vw, var(--sp-12)); padding-block: clamp(var(--sp-12), 5vw, var(--sp-16)); }
  .ft__grid--minimal { grid-template-columns: 1.25fr 2.4fr; }
  .ft__h { font-family: var(--font-body); font-size: .9375rem; font-weight: 600; color: var(--c-ink); margin-bottom: var(--sp-3); }

  .ft__brand { display: grid; align-content: start; justify-items: start; gap: var(--sp-3); padding-right: var(--sp-6); border-right: 1px solid var(--c-line); }
  .ft__tagline { font-family: var(--font-display); font-size: 1.375rem; line-height: 1.25; font-style: italic; font-weight: 500; color: var(--c-ink); max-width: 18ch; }
  .ft__status { display: flex; align-items: center; gap: var(--sp-2); min-height: 32px; font-size: .875rem; color: var(--c-text); }
  .ft__status:hover [data-status-text] { color: var(--c-accent); }
  .ft__place { color: var(--c-muted); }
  .ft__dot { width: 8px; height: 8px; border-radius: 50%; background: #B9A79B; flex: none; }
  .ft__status.is-open .ft__dot { background: var(--c-success); box-shadow: 0 0 0 3px rgba(47, 107, 63, .16); }
  .ft__social { display: flex; gap: var(--sp-2); margin-top: var(--sp-1); }
  .ft__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--c-line); background: var(--c-surface); color: var(--c-ink); transition: border-color var(--motion-fast) ease, color var(--motion-fast) ease; }
  .ft__icon:hover { border-color: var(--c-zari); color: var(--c-accent); }

  .ft__links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-6); }
  .ft__links > div + div { padding-left: var(--sp-6); border-left: 1px solid var(--c-line); }
  .ft__links ul { display: grid; gap: 0; }
  .ft__links a { display: inline-flex; min-height: 34px; align-items: center; font-size: .9375rem; color: var(--c-text); transition: color var(--motion-fast) ease; }
  .ft__links a:hover { color: var(--c-accent); }

  .ft__letters { padding-left: var(--sp-6); border-left: 1px solid var(--c-line); }
  .ft__nl-body { color: var(--c-text); font-size: .9375rem; max-width: 34ch; }
  .ft__form { display: flex; align-items: center; gap: var(--sp-2); margin-top: var(--sp-4); padding: 4px 4px 4px var(--sp-5); border: 1px solid var(--c-line); border-radius: var(--r-pill); background: var(--c-surface); transition: border-color var(--motion-base) ease; }
  .ft__form:focus-within { border-color: var(--c-accent); }
  .ft__form input { flex: 1; min-width: 0; min-height: 44px; background: transparent; border: 0; color: var(--c-ink); font-size: 16px; caret-color: var(--c-accent); }
  .ft__form input::placeholder { color: var(--c-muted); }
  .ft__form input:focus { outline: none; }
  .ft__send { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(180deg, #B76E5D, #8E4A43); color: #FFFDF8; transition: transform 220ms var(--motion-ease-out); }
  .ft__send:hover { transform: translateX(2px); }
  .ft__send:disabled { opacity: .5; }
  .ft__msg { min-height: 1.5em; margin-top: var(--sp-2); font-size: .875rem; color: var(--c-accent); }

  .ft__base { display: flex; justify-content: space-between; gap: var(--sp-4); padding-block: var(--sp-5); font-size: .8125rem; color: var(--c-muted); border-top: 1px solid var(--c-line); }
  .ft__sep { margin-inline: var(--sp-3); color: var(--c-line); }
  .ft__base a:hover { color: var(--c-ink); }

  @media (max-width: 1099px) {
    .ft__grid, .ft__grid--minimal { grid-template-columns: 1fr 1fr; }
    .ft__brand { padding-right: 0; border-right: 0; }
    .ft__links { grid-column: 1 / -1; grid-row: 2; padding-top: var(--sp-8); border-top: 1px solid var(--c-line); }
    .ft__letters { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 1023px) { .ft__base { padding-bottom: calc(var(--sp-5) + var(--tabbar-h) + env(safe-area-inset-bottom)); } } /* clear the tab bar */
  @media (max-width: 640px) {
    .ft__grid, .ft__grid--minimal { grid-template-columns: 1fr; }
    .ft__links { grid-row: auto; grid-template-columns: 1fr 1fr; }
    .ft__links > div + div { padding-left: 0; border-left: 0; }
    .ft__letters { padding-top: var(--sp-8); border-top: 1px solid var(--c-line); }
    .ft__base { flex-direction: column; }
  }
</style>

<script>
  import { t } from '@femia/i18n';
  import { track } from '../lib/analytics.ts';
  import { boutiqueStatus, type DayHours } from '../lib/hours.ts';
  import { onPage } from '../lib/lifecycle.ts';

  // The footer persists across navigations (and swaps for the checkout variant), so binding is idempotent.
  // Every live "Open now / Closed" line on the page (footer, hero window) is kept current.
  const updateStatus = () => {
    document.querySelectorAll<HTMLElement>('[data-hours]').forEach((st) => {
      const s = boutiqueStatus(JSON.parse(st.dataset.hours || 'null') as DayHours[] | null);
      if (!s) return;
      st.classList.toggle('is-open', s.open);
      const text = st.querySelector('[data-status-text]');
      if (text) text.textContent = s.text;
    });
  };
  setInterval(updateStatus, 60_000);


  onPage(() => {
    updateStatus();
    document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = '1';
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const msg = form.parentElement!.querySelector<HTMLElement>('[data-msg]')!;
        const input = form.querySelector('input')!;
        if (!input.checkValidity()) { msg.textContent = t('home.newsletter.error'); input.focus(); return; }
        const btn = form.querySelector('button')!;
        btn.disabled = true;
        try {
          const res = await fetch('/api/newsletter', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: input.value, source: 'footer' }) });
          if (!res.ok) throw new Error();
          msg.textContent = t('home.newsletter.thanks'); form.reset(); track('newsletter_signup');
        } catch { msg.textContent = t('home.newsletter.error'); }
        btn.disabled = false;
      });
    });
  });
</script>
