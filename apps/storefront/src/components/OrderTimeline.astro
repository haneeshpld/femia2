---
import type { PublicOrder } from '@femia/contracts';
import Icon from './ui/Icon.astro';
import { t } from '@femia/i18n';
interface Props { order: PublicOrder }
const { order: o } = Astro.props;
const steps = ['new', 'confirmed', 'packed', 'shipped', 'delivered'] as const;
const at = (s: string) => o.timeline.find((e) => e.status === s)?.at;
const reached = o.status === 'cancelled' ? -1 : o.status === 'pending_payment' ? -1 : steps.indexOf(o.status as (typeof steps)[number]);
const fmt = (iso?: string) => iso ? new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Kolkata' }).format(new Date(iso)) : '';
---
{o.status === 'cancelled' ? (
  <p class="tl-cancel"><Icon name="info" /> {t('status.cancelled')}{o.timeline.findLast((e) => e.status === 'cancelled')?.note ? `: ${o.timeline.findLast((e) => e.status === 'cancelled')!.note}` : ''}</p>
) : (
  <ol class="tl" role="list">
    {o.status === 'pending_payment' && <li class="tl__step is-current"><span class="tl__dot"><Icon name="clock" size={16} /></span><div><strong>{t('status.pending_payment')}</strong></div></li>}
    {steps.map((s, i) => (
      <li class:list={['tl__step', { 'is-done': i <= reached, 'is-current': i === reached }]} aria-current={i === reached ? 'step' : undefined}>
        <span class="tl__dot">{i <= reached ? <Icon name="check" size={16} /> : null}</span>
        <div>
          <strong>{t(`status.${s}`)}</strong>
          {at(s) && <span class="muted">{fmt(at(s))}</span>}
          {s === 'shipped' && i <= reached && o.courier && (
            <span class="tl__ship">{o.courier}{o.trackingNumber && ` · ${o.trackingNumber}`}{o.trackingUrl && <> · <a href={o.trackingUrl} target="_blank" rel="noopener">Track with courier</a></>}</span>
          )}
        </div>
      </li>
    ))}
  </ol>
)}
<style>
  .tl { display: grid; gap: 0; }
  .tl__step { position: relative; display: grid; grid-template-columns: 32px 1fr; gap: var(--sp-4); padding-bottom: var(--sp-6); color: var(--c-muted); }
  .tl__step::before { content: ''; position: absolute; left: 15px; top: 32px; bottom: 0; width: 2px; background: var(--c-line); }
  .tl__step:last-child::before { display: none; }
  .tl__step.is-done::before { background: var(--c-accent); }
  .tl__dot { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; border: 2px solid var(--c-line); background: var(--c-surface); color: var(--c-white); }
  .tl__step.is-done .tl__dot { background: var(--c-accent); border-color: var(--c-accent); }
  .tl__step.is-current .tl__dot { box-shadow: 0 0 0 5px rgba(142, 74, 67, .15); }
  .tl__step.is-current:not(.is-done) .tl__dot { color: var(--c-accent); border-color: var(--c-accent); }
  .tl__step div { display: grid; padding-top: 4px; }
  .tl__step.is-done strong, .tl__step.is-current strong { color: var(--c-ink); }
  .tl__step .muted { font-size: .875rem; }
  .tl__ship { font-size: .9375rem; color: var(--c-text); }
  .tl__ship a { color: var(--c-accent); text-decoration: underline; }
  .tl-cancel { display: flex; gap: var(--sp-2); align-items: center; padding: var(--sp-4); border-radius: var(--r-md); background: #FBEAEA; color: var(--c-danger); font-weight: 600; }
</style>
