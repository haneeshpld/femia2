---
/**
 * Visit the boutique: an editorial two-column section.
 * Left, the boutique photo in an arched doorway frame (a fine gold line just inside the arch); as the section scrolls
 * in, the arch opens gently from narrow to full width (CSS scroll-driven; the finished frame without it). Right,
 * left-aligned: the heading, a line of copy, then Address and Hours under a hairline, the live open/closed line, and
 * one clear action (Get directions) with WhatsApp as a quiet link. Phones: the photo, then the text.
 * Used on the home page (h2) and the Visit page (h1).
 */
import type { MediaRef, PublicSettings } from '@femia/contracts';
import Icon from '../ui/Icon.astro';
import { emph, srcset } from '../../lib/format.ts';
import { boutiqueStatus } from '../../lib/hours.ts';
import { t } from '@femia/i18n';
interface Props { block: Record<string, any>; image?: MediaRef; store: PublicSettings['store']; headingLevel?: 'h1' | 'h2'; uid?: string }
const { block: b, image, store, headingLevel = 'h2', uid = 'boutique' } = Astro.props;
const H = headingLevel;
const wa = store.whatsapp ? `https://wa.me/${store.whatsapp.replace(/\D/g, '').replace(/^(\d{10})$/, '91$1')}?text=${encodeURIComponent('Hi Femia! I would like to visit the boutique.')}` : null;
const street = [store.address.line1, store.address.line2].filter(Boolean).join(', ');
const town = store.address.city;
const status = boutiqueStatus(store.hours);
---
<section class="section boutique" aria-labelledby={`${uid}-title`}>
  <div class="container boutique__grid">
    <div class="boutique__frame">
      <div class="boutique__door">
        {image && <img src={image.src['960']} srcset={srcset(image)} sizes="(min-width: 900px) 46vw, 92vw" width={image.width} height={image.height} alt={image.alt} loading="lazy" decoding="async" />}
      </div>
    </div>

    <div class="boutique__copy">
      <H id={`${uid}-title`} class="boutique__title" set:html={emph(b.title)} />
      {b.body && <p class="boutique__body">{b.body}</p>}
      <dl class="boutique__facts">
        {(street || town) && (
          <div>
            <dt>Address</dt>
            <dd>{street}{street && town && <br />}{town}</dd>
          </div>
        )}
        {store.hoursSummary && (
          <div>
            <dt>Hours</dt>
            <dd>{store.hoursSummary}</dd>
          </div>
        )}
      </dl>
      {status && (
        <a class:list={['boutique__status', { 'is-open': status.open }]} href="/visit" data-hours={JSON.stringify(store.hours)}>
          <span class="boutique__dot" aria-hidden="true"></span><span data-status-text>{status.text}</span>
        </a>
      )}
      <div class="boutique__ctas">
        {store.mapUrl && <a class="btn" href={store.mapUrl} target="_blank" rel="noopener"><Icon name="navigate" size={18} /> {t('home.boutique.directions')}</a>}
        {wa && <a class="link-arrow" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> {t('home.boutique.whatsapp')}</a>}
      </div>
    </div>
  </div>
</section>
<style>
  .boutique__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(var(--sp-10), 6vw, var(--sp-24)); align-items: center; }

  /* the arched doorway */
  .boutique__frame { position: relative; }
  .boutique__door { position: relative; aspect-ratio: 1.12; overflow: clip; border-radius: 999px 999px var(--r-img) var(--r-img); background: var(--c-sand); }
  .boutique__door img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 70%; }
  .boutique__door::after { /* a fine gold line just inside the arch */
    content: ''; position: absolute; inset: 12px 12px 0; border: 1px solid rgba(230, 207, 164, .85); border-bottom: 0;
    border-radius: 999px 999px 0 0; pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .boutique__door { animation: door-open linear both; animation-timeline: view(); animation-range: entry 0% cover 40%; }
      .boutique__door img { animation: door-settle linear both; animation-timeline: view(); animation-range: entry 0% cover 40%; }
    }
  }
  @keyframes door-open { from { clip-path: inset(0 22% 0 22% round 999px 999px 0 0); } to { clip-path: inset(0 0 0 0 round 999px 999px 0 0); } }
  @keyframes door-settle { from { scale: 1.12; } to { scale: 1; } }

  /* the text */
  .boutique__copy { display: grid; justify-items: start; gap: var(--sp-5); max-width: 520px; }
  .boutique__title { font-family: var(--font-display); font-size: var(--fs-section); font-weight: 500; line-height: 1.02; letter-spacing: -.015em; color: var(--c-ink); text-wrap: balance; }
  .boutique__title :global(em) { font-style: italic; color: var(--c-accent); font-weight: 500; }
  .boutique__body { max-width: 44ch; font-size: var(--fs-md); line-height: 1.6; color: var(--c-text); }
  .boutique__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-6); width: 100%; margin-top: var(--sp-2); padding-top: var(--sp-5); border-top: 1px solid var(--c-line); }
  .boutique__facts dt { font-size: .8125rem; color: var(--c-muted); margin-bottom: var(--sp-1); }
  .boutique__facts dd { font-size: 1rem; line-height: 1.5; color: var(--c-ink); }
  .boutique__status { display: inline-flex; align-items: center; gap: var(--sp-2); min-height: 32px; font-size: .9375rem; color: var(--c-ink); }
  .boutique__status:hover [data-status-text] { text-decoration: underline; text-decoration-color: var(--c-zari); text-underline-offset: 3px; }
  .boutique__dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: #B9A79B; }
  .boutique__status.is-open .boutique__dot { background: var(--c-success); box-shadow: 0 0 0 3px rgba(47, 107, 63, .18); }
  .boutique__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-3) var(--sp-8); margin-top: var(--sp-2); }

  @media (max-width: 899px) {
    .boutique__grid { grid-template-columns: minmax(0, 1fr); }
    .boutique__door { aspect-ratio: 1; }
    .boutique__copy { max-width: none; }
  }
  @media (max-width: 479px) {
    .boutique__facts { grid-template-columns: minmax(0, 1fr); gap: var(--sp-4); }
    .boutique__ctas .btn { width: 100%; }
  }
</style>
