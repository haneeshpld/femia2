---
import type { Collection, MediaRef } from '@femia/contracts';
import Icon from '../ui/Icon.astro';
import { srcset } from '../../lib/format.ts';
import { t } from '@femia/i18n';
interface Props { eyebrow: string; title: string; items: { collection: Collection; title: string; image: MediaRef | null }[] }
const { eyebrow, title, items } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
{items.length > 0 && (
  <section class="section occ" aria-labelledby="occ-title" data-carousel>
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">{eyebrow}</p><h2 id="occ-title">{title}</h2></div>
        <div class="occ__ctrl">
          <p class="occ__count" aria-hidden="true"><span data-current>01</span> / {pad(items.length)}</p>
          <button type="button" class="occ__btn" data-prev aria-label={t('common.prev')}><Icon name="chevronLeft" size={20} /></button>
          <button type="button" class="occ__btn" data-next aria-label={t('common.next')}><Icon name="chevronRight" size={20} /></button>
        </div>
      </div>
    </div>
    <ul role="list" class="occ__track container" data-track>
      {items.map((it) => (
        <li class="occ__item">
          <a href={`/collections/${it.collection.slug}`} class="occ__card">
            {it.image && <img src={it.image.src['960']} srcset={srcset(it.image)} sizes="(min-width: 1024px) 36vw, 82vw" width={it.image.width} height={it.image.height} alt={it.image.alt} loading="lazy" decoding="async" />}
            <span class="occ__label"><span class="occ__name">{it.title}</span><span class="occ__cta">{t('common.explore')} <Icon name="arrowRight" size={18} /></span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
<style>
  .occ__ctrl { display: flex; align-items: center; gap: var(--sp-3); }
  .occ__count { font-size: .9375rem; color: var(--c-ink); margin-right: var(--sp-3); font-variant-numeric: tabular-nums; }
  .occ__btn { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--c-maroon); color: var(--c-maroon); transition: background var(--motion-fast) ease, color var(--motion-fast) ease; }
  .occ__btn:hover { background: var(--c-maroon); color: var(--c-white); }
  .occ__btn:disabled { opacity: .35; pointer-events: none; }
  .occ__track { display: flex; gap: var(--sp-4); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-padding-inline: var(--layout-gutter); }
  .occ__track::-webkit-scrollbar { display: none; }
  .occ__item { flex: 0 0 clamp(260px, 37%, 460px); scroll-snap-align: start; }
  .occ__card { position: relative; display: block; aspect-ratio: 1.2; border-radius: var(--r-md); overflow: hidden; background: var(--c-sand); }
  .occ__card img { width: 100%; height: 100%; object-fit: cover; transition: transform 1100ms var(--motion-ease-out); }
  .occ__card:hover img { transform: scale(1.05); }
  .occ__card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(58, 18, 12, .62) 100%); }
  .occ__label { position: absolute; left: var(--sp-6); bottom: var(--sp-5); z-index: 1; display: grid; gap: var(--sp-1); color: var(--c-white); }
  .occ__name { font-family: var(--font-display); font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem); font-weight: 500; line-height: 1.1; }
  .occ__cta { display: inline-flex; align-items: center; gap: var(--sp-2); font-weight: 600; }
  @media (max-width: 767px) {
    .occ__ctrl { display: none; }
    .occ__item { flex-basis: 84%; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const items = [...track.children] as HTMLElement[];
    const cur = root.querySelector('[data-current]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const index = () => {
      const left = track.scrollLeft + 1;
      let i = 0; items.forEach((it, n) => { if (it.offsetLeft - track.offsetLeft <= left + it.offsetWidth / 2) i = n; });
      return i;
    };
    const update = () => {
      const i = index();
      if (cur) cur.textContent = String(i + 1).padStart(2, '0');
      if (prev) prev.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    const go = (d: number) => {
      const target = items[Math.max(0, Math.min(items.length - 1, index() + d))];
      if (target) track.scrollTo({ left: target.offsetLeft - track.offsetLeft - parseFloat(getComputedStyle(track).paddingLeft), behavior: 'smooth' });
    };
    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    update();
  });
</script>
