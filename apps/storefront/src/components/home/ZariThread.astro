---
/**
 * One gold zari thread stitched through the whole home page: it leaves the hero's stitch,
 * weaves through the side margins behind each section, and joins the footer's zari band.
 * The route is computed from the real layout, so it survives owner content changes and every screen width.
 */
---
<div class="thread" aria-hidden="true" data-thread>
  <svg class="thread__svg" data-thread-svg>
    <defs>
      <mask id="thread-draw" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%">
        <path data-thread-mask fill="none" stroke="#fff" stroke-width="8" stroke-linecap="round" />
      </mask>
      <linearGradient id="thread-gold" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#9A6E22" />
        <stop offset=".5" stop-color="#C79A3E" />
        <stop offset="1" stop-color="#EBCB82" />
      </linearGradient>
      <filter id="needle-shadow" x="-20%" y="-200%" width="140%" height="500%">
        <feDropShadow dx="0" dy="1.6" stdDeviation="1.3" flood-color="#2F2721" flood-opacity=".35" />
      </filter>
    </defs>
    <path data-thread-path mask="url(#thread-draw)" fill="none" stroke="url(#thread-gold)" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="9 6" />
  </svg>
</div>
<!-- The needle rides just above the thread and, like it, passes behind the page content. -->
<div class="needle-layer" aria-hidden="true" data-needle-layer>
  <svg class="thread__svg">
    <!-- Sewing needle. Local axes: eye at the origin (where the thread arrives), point at +x (direction of travel). -->
    <g data-thread-needle class="thread__needle">
      <g data-needle-body>
        <!-- Femia gold needle (design/reference/needle-gold.png → tools/brand/needle.mjs). Eye centre sits on the origin. -->
        <image href="/brand/needle.webp" x="-13.09" y="-3.58" width="92.00" height="7.86" filter="url(#needle-shadow)" preserveAspectRatio="none" />
        <!-- thread pulled through the eye, its loose tail falling back over the rim -->
        <path d="M-1.8 0.1 L 2.2 -0.1" stroke="#C79A3E" stroke-width="1.2" stroke-linecap="round" />
        <path d="M1.6 0.2 C 1 3.4, -5 6.4, -15 7.4" fill="none" stroke="url(#thread-gold)" stroke-width="1.4" stroke-linecap="round" stroke-dasharray="6 4" />
      </g>
    </g>
  </svg>
</div>

<style>
  .thread { position: absolute; top: 0; left: 0; width: 100%; height: 0; z-index: 0; pointer-events: none; }
  .thread__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .needle-layer { position: absolute; top: 0; left: 0; width: 100%; height: 0; z-index: 0; pointer-events: none; }
  .thread__needle { opacity: 0; transition: opacity 300ms ease; }
  .needle-layer.is-drawing .thread__needle { opacity: 1; }
  /* Sections sit above the thread so it passes behind cards and bands (woven), and shows in the gaps. */
  :global(#main) { position: relative; }
  :global(#main > section:not(.hero)) { position: relative; z-index: 1; }
  @media print { .thread, .needle-layer { display: none; } }
</style>

<script>
  import { onPage } from '../../lib/lifecycle.ts';

  // Rebuilt from the live layout every time the home page is shown; listeners are removed on leave.
  onPage(() => {
  const root = document.querySelector<HTMLElement>('[data-thread]');
  const main = document.getElementById('main');
  if (root && main) {
    const svg = root.querySelector<SVGSVGElement>('[data-thread-svg]')!;
    const path = root.querySelector<SVGPathElement>('[data-thread-path]')!;
    const mask = root.querySelector<SVGPathElement>('[data-thread-mask]')!;
    const layer = document.querySelector<HTMLElement>('[data-needle-layer]')!;
    const needle = layer.querySelector<SVGGElement>('[data-thread-needle]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let table: { y: number; len: number }[] = [];
    let total = 0;
    let top = 0;

    const rel = (el: Element | null) => {
      if (!el) return null;
      const r = el.getBoundingClientRect(), m = main.getBoundingClientRect();
      return { left: r.left - m.left, right: r.right - m.left, top: r.top - m.top, bottom: r.bottom - m.top, cy: r.top - m.top + r.height / 2 };
    };

    /** Catmull-Rom through the points → smooth cubic Bézier path. */
    const smooth = (pts: [number, number][]) => {
      let d = `M${pts[0]![0].toFixed(1)} ${pts[0]![1].toFixed(1)}`;
      for (let i = 0; i < pts.length - 1; i++) {
        const p0 = pts[i - 1] ?? pts[i]!, p1 = pts[i]!, p2 = pts[i + 1]!, p3 = pts[i + 2] ?? p2;
        const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
        const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
        d += ` C${c1[0]!.toFixed(1)} ${c1[1]!.toFixed(1)}, ${c2[0]!.toFixed(1)} ${c2[1]!.toFixed(1)}, ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
      }
      return d;
    };

    function build() {
      const W = main!.clientWidth;
      const cont = main!.querySelector('.cats .container') ?? main!.querySelector('.container');
      const cs = cont ? getComputedStyle(cont) : null;
      const c = rel(cont);
      const padL = cs ? parseFloat(cs.paddingLeft) : 16;
      const narrow = W < 768;
      const L = narrow ? 7 : Math.max(10, (c?.left ?? 0) + padL - 30);
      const R = narrow ? W - 7 : Math.min(W - 10, (c?.right ?? W) - padL + 30);
      const footer = document.querySelector('[data-footer]');
      const trust = document.querySelector('.trust');
      const stitch = rel(main!.querySelector('.hero__stitch'));
      const hero = rel(main!.querySelector('.hero'));
      const q = (s: string) => rel(main!.querySelector(s));
      const end = footer ? rel(footer)!.top : main!.scrollHeight;

      const pts: [number, number][] = [];
      if (stitch) pts.push([stitch.right, stitch.cy]);
      else if (hero) pts.push([W * 0.4, hero.bottom - 60]);
      const add = (x: number, y: number | undefined) => { if (y !== undefined && y > (pts.at(-1)?.[1] ?? -1) + 40) pts.push([x, y]); };
      if (hero) add(R, hero.bottom + 24);
      // Weave through whatever sections the owner has on the page, alternating sides:
      // past each section's heading on one side, out under its content on the other.
      let side = 1;
      main!.querySelectorAll(':scope > section:not(.hero)').forEach((sec) => {
        const r = rel(sec)!;
        const head = rel(sec.querySelector('.section-head, h2'));
        add(side > 0 ? R : L, head ? head.cy : r.top + 60);
        side = -side;
        add(side > 0 ? R : L, r.bottom - 30);
      });
      const tr = rel(trust);
      if (tr) add(narrow ? L : L - 8, tr.bottom);
      add(W / 2, end + 2);
      if (pts.length < 2) return;

      root!.style.height = `${end + 4}px`;
      layer.style.height = `${end + 4}px`;
      const d = smooth(pts);
      path.setAttribute('d', d);
      mask.setAttribute('d', d);
      total = path.getTotalLength();
      mask.style.strokeDasharray = `${total} ${total}`;
      // Length lookup by height so the tip tracks the reading position, not the curve length.
      table = [];
      let maxY = -Infinity;
      for (let i = 0; i <= 600; i++) {
        const len = (total * i) / 600;
        const p = path.getPointAtLength(len);
        maxY = Math.max(maxY, p.y);
        table.push({ y: maxY, len });
      }
      top = main!.getBoundingClientRect().top + scrollY;
      if (reduced) { mask.style.strokeDashoffset = '0'; return; }
      draw(current, true);
    }

    const lenAtY = (y: number) => {
      if (!table.length) return 0;
      let lo = 0, hi = table.length - 1;
      while (lo < hi) { const mid = (lo + hi) >> 1; if (table[mid]!.y < y) lo = mid + 1; else hi = mid; }
      return table[lo]!.len;
    };

    let current = 0;
    let target = 0;
    function draw(len: number, force = false) {
      if (!total) return;
      if (!force && Math.abs(len - current) < 0.3) return;
      current = len;
      mask.style.strokeDashoffset = String(total - len);
      const p = path.getPointAtLength(Math.max(0.01, len));
      const p2 = path.getPointAtLength(Math.max(0, len - 2));
      const angle = (Math.atan2(p.y - p2.y, p.x - p2.x) * 180) / Math.PI;
      // A gentle dip in and out, as if stitching; it only moves while the thread does.
      const dip = Math.sin(len / 26) * 9;
      const size = innerWidth < 768 ? 0.8 : 1;
      needle.setAttribute('transform', `translate(${p.x.toFixed(1)} ${p.y.toFixed(1)}) rotate(${(angle + dip).toFixed(1)}) scale(${size})`);
      layer.classList.toggle('is-drawing', len > 4 && len < total - 4);
    }

    // Ease the tip toward the reading line (62% down the viewport); never runs while idle.
    let raf = 0;
    const tick = () => {
      const next = current + (target - current) * 0.14;
      draw(Math.abs(target - next) < 0.5 ? target : next);
      raf = Math.abs(target - current) > 0.5 ? requestAnimationFrame(tick) : 0;
    };
    const onScroll = () => {
      target = Math.min(total, lenAtY(scrollY + innerHeight * 0.62 - top));
      if (!raf) raf = requestAnimationFrame(tick);
    };

    let pending = 0;
    const rebuild = () => { cancelAnimationFrame(pending); pending = requestAnimationFrame(() => { build(); if (!reduced) onScroll(); }); };
    const ro = new ResizeObserver(rebuild);
    ro.observe(main);
    addEventListener('load', rebuild);
    document.fonts?.ready.then(rebuild);
    if (!reduced) addEventListener('scroll', onScroll, { passive: true });
    rebuild();
    void svg;
    return () => {
      ro.disconnect();
      removeEventListener('load', rebuild);
      removeEventListener('scroll', onScroll);
      cancelAnimationFrame(raf); cancelAnimationFrame(pending);
    };
  }
  });
</script>
