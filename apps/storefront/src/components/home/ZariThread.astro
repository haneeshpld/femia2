---
/**
 * The tailor's thread: one gold zari thread sewn down the whole home page, led by a needle that follows your scroll.
 * It comes out from under the hero, runs down the side margins as a hand-sewn running stitch (never across text),
 * and crosses the page only in the empty space between sections in one soft drape. Above the footer it ties a
 * small knot. (Premium pass: the paisley loops and the needle were retired; the thread is the page's one signature.)
 * The route is computed from the real layout, so it survives owner content changes and every screen width.
 * Reduced motion: the finished stitching, no needle.
 */
---
<div class="thread" aria-hidden="true" data-thread>
  <svg class="thread__svg" data-thread-svg>
    <defs>
      <mask id="thread-draw" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%">
        <path data-thread-mask fill="none" stroke="#fff" stroke-width="10" stroke-linecap="round" />
      </mask>
      <linearGradient id="thread-gold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#94703F" />
        <stop offset=".35" stop-color="#C8A574" />
        <stop offset=".6" stop-color="#E6CFA4" />
        <stop offset="1" stop-color="#94703F" />
      </linearGradient>
      <filter id="needle-shadow" x="-20%" y="-200%" width="140%" height="500%">
        <feDropShadow dx="0" dy="1.6" stdDeviation="1.3" flood-color="#2F2721" flood-opacity=".35" />
      </filter>
    </defs>
    <!-- running stitch: thread on top, then a gap where it passes under the cloth -->
    <path data-thread-path mask="url(#thread-draw)" fill="none" stroke="url(#thread-gold)" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="8 6" opacity=".7" />
  </svg>
</div>
<!-- The needle rides the tip of the thread and, like it, passes behind the page content. -->
<div class="needle-layer" aria-hidden="true" data-needle-layer>
  <svg class="thread__svg">
    <!-- Sewing needle. Local axes: eye at the origin (where the thread arrives), point at +x (direction of travel). -->
    <g data-thread-needle class="thread__needle">
      <g data-needle-body>
        <!-- Femia gold needle (design/reference/needle-gold.png → tools/brand/needle.mjs). Eye centre sits on the origin. -->
        <image href="/brand/needle.webp" x="-13.09" y="-3.58" width="92.00" height="7.86" filter="url(#needle-shadow)" preserveAspectRatio="none" />
        <path d="M-1.8 0.1 L 2.2 -0.1" stroke="#C79A3E" stroke-width="1.2" stroke-linecap="round" />
      </g>
    </g>
  </svg>
</div>

<style>
  .thread { position: absolute; top: 0; left: 0; width: 100%; height: 0; z-index: 0; pointer-events: none; }
  .thread__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .needle-layer { position: absolute; top: 0; left: 0; width: 100%; height: 0; z-index: 0; pointer-events: none; }
  .thread__needle { opacity: 0; transition: opacity 400ms ease; }
  .needle-layer.is-ready .thread__needle { opacity: 1; }
  /* Sections sit above the thread so it passes behind cards and bands (woven), and shows in the gaps. */
  :global(#main) { position: relative; }
  :global(#main > section) { position: relative; z-index: 1; } /* the hero too: the thread comes out from under it */
  @media print { .thread, .needle-layer { display: none; } }
</style>

<script>
  import { onPage } from '../../lib/lifecycle.ts';

  type Pt = { x: number; y: number; a: number }; // a = the reading height at which the needle reaches this point

  onPage(() => {
    const root = document.querySelector<HTMLElement>('[data-thread]');
    const main = document.getElementById('main');
    if (!root || !main) return;
    const path = root.querySelector<SVGPathElement>('[data-thread-path]')!;
    const mask = root.querySelector<SVGPathElement>('[data-thread-mask]')!;
    const layer = document.querySelector<HTMLElement>('[data-needle-layer]')!;
    const needle = layer.querySelector<SVGGElement>('[data-thread-needle]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let anchors: { a: number; len: number }[] = [];
    let total = 0, top = 0;

    const rel = (el: Element | null) => {
      if (!el) return null;
      const r = el.getBoundingClientRect(), m = main.getBoundingClientRect();
      return { left: r.left - m.left, right: r.right - m.left, top: r.top - m.top, bottom: r.bottom - m.top, h: r.height };
    };
    /** A section's content box: its box minus its vertical padding. */
    const content = (el: Element) => {
      const r = rel(el)!, s = getComputedStyle(el);
      return { top: r.top + parseFloat(s.paddingTop), bottom: r.bottom - parseFloat(s.paddingBottom) };
    };

    /** Catmull-Rom through the points → smooth cubic Bézier path. */
    const smooth = (pts: Pt[]) => {
      const f = (n: number) => n.toFixed(1);
      let d = `M${f(pts[0]!.x)} ${f(pts[0]!.y)}`;
      for (let i = 0; i < pts.length - 1; i++) {
        const p0 = pts[i - 1] ?? pts[i]!, p1 = pts[i]!, p2 = pts[i + 1]!, p3 = pts[i + 2] ?? p2;
        d += ` C${f(p1.x + (p2.x - p0.x) / 6)} ${f(p1.y + (p2.y - p0.y) / 6)}, ${f(p2.x - (p3.x - p1.x) / 6)} ${f(p2.y - (p3.y - p1.y) / 6)}, ${f(p2.x)} ${f(p2.y)}`;
      }
      return d;
    };

    function build() {
      const W = main!.clientWidth;
      const narrow = W < 768;
      const cont = main!.querySelector('.section .container') ?? main!.querySelector('.container');
      const c = rel(cont), padL = cont ? parseFloat(getComputedStyle(cont).paddingLeft) : 16;
      // The two lanes the thread runs down: just outside the content on wide screens, the very edge on phones.
      const L = narrow ? 7 : Math.max(12, (c?.left ?? 0) + padL - 30);
      const R = narrow ? W - 7 : Math.min(W - 12, (c?.right ?? W) - padL + 30);
      const lane = (s: number) => (s > 0 ? R : L);
      const sag = narrow ? 10 : 34;                                  // how far a crossing droops between lane and paisley
      const footer = document.querySelector('[data-footer]');
      const end = footer ? rel(footer)!.top : main!.scrollHeight;

      const pts: Pt[] = [];
      const push = (x: number, y: number, a = y) => pts.push({ x, y, a: Math.max(a, pts.at(-1)?.a ?? -Infinity) });
      // A hand-sewn run down one lane, wavering a few pixels.
      const run = (s: number, y0: number, y1: number) => {
        const n = Math.max(1, Math.round((y1 - y0) / 170));
        for (let k = 1; k <= n; k++) push(lane(s) + (k % 2 ? -1 : 1) * s * (narrow ? 2 : 5), y0 + ((y1 - y0) * k) / n);
      };
      // Cross the page in an empty gap: the thread drapes across in one soft curve (premium pass: no motif, no needle).
      const cross = (s: number, gTop: number, gBot: number) => {
        const yA = gTop + (gBot - gTop) * 0.2, yB = gBot - (gBot - gTop) * 0.2;
        const xA = lane(s), xB = lane(-s);
        push(xA, yA);
        push(xA + (xB - xA) * 0.3, yA + (yB - yA) * 0.3 + sag, yA + (yB - yA) * 0.3);
        push(xA + (xB - xA) * 0.7, yA + (yB - yA) * 0.7 + sag, yA + (yB - yA) * 0.7);
        push(xB, yB);
      };

      // Start: the thread comes out from under the hero's foot (the hero sits above it), below the rail.
      const hero = main!.querySelector('.hero');
      let side = 1;
      let y = hero ? rel(hero)!.bottom : 0;
      push(R, Math.max(0, y - 40), 0);

      const blocks = [...main!.querySelectorAll(':scope > section:not(.hero)'), document.querySelector('.trust')]
        .filter((el): el is Element => !!el && rel(el)!.h > 0);
      for (const el of blocks) {
        const box = content(el);
        if (box.top - y > 110) { cross(side, y, box.top); side = -side; }
        else if (box.top > y) push(lane(side), box.top);
        run(side, Math.max(y, box.top), box.bottom);
        y = box.bottom;
      }
      // Finish: come in to the middle above the footer and tie a small knot.
      const knotY = Math.min(end - 24, y + 70);
      push(W / 2 + side * 40, knotY - 8);
      push(W / 2, knotY);
      push(W / 2 - 7, knotY - 9);
      push(W / 2 - 1, knotY - 15);
      push(W / 2 + 6, knotY - 6);
      push(W / 2 + 26, knotY + 4);
      if (pts.length < 2) return;

      root!.style.height = `${end + 4}px`;
      layer.style.height = `${end + 4}px`;
      const d = smooth(pts);
      path.setAttribute('d', d);
      mask.setAttribute('d', d);
      total = path.getTotalLength();
      mask.style.strokeDasharray = `${total} ${total}`;

      // Where along the thread each point falls, so scroll position maps to length — loops included.
      const N = Math.min(5000, Math.ceil(total / 3));
      const samples = Array.from({ length: N + 1 }, (_, i) => { const p = path.getPointAtLength((total * i) / N); return { x: p.x, y: p.y, len: (total * i) / N }; });
      anchors = [];
      let from = 0;
      for (const p of pts) {
        let best = from, bestD = Infinity;
        for (let i = from; i < samples.length; i++) {
          const s = samples[i]!, dd = (s.x - p.x) ** 2 + (s.y - p.y) ** 2;
          if (dd < bestD) { bestD = dd; best = i; }
          if (bestD < 9 && dd > 400) break;                         // found it and moved well past
        }
        from = best;
        anchors.push({ a: p.a, len: samples[best]!.len });
      }
      top = main!.getBoundingClientRect().top + scrollY;
      if (reduced) { mask.style.strokeDashoffset = '0'; return; }
      // premium pass: the needle is retired; the thread draws itself quietly
      draw(current, true);
    }

    const lenAt = (y: number) => {
      if (!anchors.length) return 0;
      if (y <= anchors[0]!.a) return 0;
      for (let i = 1; i < anchors.length; i++) {
        const p = anchors[i - 1]!, q = anchors[i]!;
        if (y <= q.a) return q.a === p.a ? q.len : p.len + ((y - p.a) / (q.a - p.a)) * (q.len - p.len);
      }
      return total;
    };

    let current = 0, target = 0;
    function draw(len: number, force = false) {
      if (!total) return;
      if (!force && Math.abs(len - current) < 0.3) return;
      current = len;
      mask.style.strokeDashoffset = String(total - len);
      const p = path.getPointAtLength(Math.max(0.01, len));
      const q = path.getPointAtLength(Math.max(0, len - 3));
      let angle = (Math.atan2(p.y - q.y, p.x - q.x) * 180) / Math.PI;
      if (len < 3) angle = 90;                                       // at rest on the rail, pointing down the page
      // A small dip in and out of the cloth with every stitch; it only moves while the thread does.
      const dip = Math.sin(len / 17 * Math.PI) * 7;
      const size = innerWidth < 768 ? 0.78 : 1;
      needle.setAttribute('transform', `translate(${p.x.toFixed(1)} ${p.y.toFixed(1)}) rotate(${(angle + dip).toFixed(1)}) scale(${size})`);
    }

    // Ease the tip toward the reading line (62% down the screen); nothing runs while idle.
    let raf = 0;
    const tick = () => {
      const next = current + (target - current) * 0.16;
      draw(Math.abs(target - next) < 0.5 ? target : next);
      raf = Math.abs(target - current) > 0.5 ? requestAnimationFrame(tick) : 0;
    };
    const onScroll = () => {
      target = Math.min(total, lenAt(scrollY + innerHeight * 0.62 - top));
      if (!raf) raf = requestAnimationFrame(tick);
    };

    let pending = 0;
    const rebuild = () => { cancelAnimationFrame(pending); pending = requestAnimationFrame(() => { build(); if (!reduced) onScroll(); }); };
    const ro = new ResizeObserver(rebuild);
    ro.observe(main);
    addEventListener('load', rebuild);
    document.fonts?.ready.then(rebuild);
    if (!reduced) addEventListener('scroll', onScroll, { passive: true });
    rebuild();
    return () => {
      ro.disconnect();
      removeEventListener('load', rebuild);
      removeEventListener('scroll', onScroll);
      cancelAnimationFrame(raf); cancelAnimationFrame(pending);
    };
  });
</script>
