---
/**
 * Home hero: "the rail".
 * The boutique's rail of new pieces, hung on a brass rod that runs off the edge of the screen. The owner's photo
 * hangs first, open; the newest pieces hang beside it as narrow slices with their names running up the side, like
 * garment tags. Point at (or tab to) a piece and it slides open while the others close up, as hangers do when you
 * push them along a rail. On load the garments drop onto the rail one after another.
 * Phones: headline, then the rail as a swipeable strip, then the buttons.
 */
import Icon from '../ui/Icon.astro';
import { formatINR, srcset } from '../../lib/format.ts';
import { api } from '../../lib/api.ts';
import { boutiqueStatus, type DayHours } from '../../lib/hours.ts';
import { PHONE, TABLET, type DeviceImages } from '../../lib/hero.ts';
interface Props { hero: Record<string, any>; images: DeviceImages; city?: string; hours?: DayHours[] | null; rail?: { sort: 'new' | 'popular'; collection?: string; category?: string } }
const { hero: h, images, city, hours = null, rail = { sort: 'new' } } = Astro.props;
const status = boutiqueStatus(hours);
// Four pieces still in stock hang beside the photo: the newest unless the owner picked another source in Admin.
const pieces = await api().catalog.products({ ...rail, pageSize: 8 })
  .then((r) => r.items.filter((p) => !p.soldOut && p.images.length).slice(0, 4)).catch(() => []);
// Desktop / tablet / phone photos from Admin; each falls back to the next larger one.
const { desktop: image, tablet, mobile } = images;
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__stage">
    <h1 id="hero-title" class="hero__title">
      <span class="split-line"><span class="hero__line" data-hero-line>{h.title}</span></span>
      {h.titleAccent && <span class="split-line"><span class="hero__line hero__accent" data-hero-line>{h.titleAccent}</span></span>}
    </h1>

    <ul class="rail" role="list" aria-label="New arrivals">
      <li class="rail__item rail__item--lead">
        <div class="rail__frame">
          {image && (
            <picture>
              {mobile && mobile !== image && <source media={PHONE} srcset={srcset(mobile)} sizes="72vw" width={mobile.width} height={mobile.height} />}
              {tablet && tablet !== image && <source media={TABLET} srcset={srcset(tablet)} sizes="(min-width: 900px) 34vw, 72vw" width={tablet.width} height={tablet.height} />}
              <img src={image.src['960']} srcset={srcset(image)} sizes="(min-width: 900px) 34vw, 72vw" width={image.width} height={image.height}
                alt={image.alt ?? ''} fetchpriority="high" decoding="async" />
            </picture>
          )}
        </div>
      </li>
      {pieces.map((p) => {
        const img = p.images.find((i) => i.role === 'main') ?? p.images[0]!;
        return (
          <li class="rail__item">
            <a class="rail__frame rail__link" href={`/products/${p.slug}`}>
              <img src={img.src['480']} srcset={srcset(img)} sizes="(min-width: 900px) 30vw, 44vw" width={img.width} height={img.height} alt="" loading="eager" decoding="async" />
              <span class="rail__tag" aria-hidden="true">{p.title}</span>
              <span class="rail__cap"><span class="rail__name">{p.title}</span><span class="rail__price">{formatINR(p.price)}</span></span>
            </a>
          </li>
        );
      })}
    </ul>

    <div class="hero__act">
      {h.body && <p class="hero__body" data-hero-fade>{h.body}</p>}
      <div class="hero__ctas" data-hero-fade>
        <a class="btn" href={h.ctaLink}>{h.ctaLabel} <Icon name="arrowRight" size={18} class="arrow" /></a>
        {h.secondaryLabel && h.secondaryLink && <a class="btn btn--outline" href={h.secondaryLink}>{h.secondaryLabel}</a>}
      </div>
    </div>

    {(h.eyebrow || status) && (
      <div class="hero__foot" data-hero-fade>
        {h.eyebrow && <p class="hero__tag">{h.eyebrow}</p>}
        {status && (
          <a class:list={['hero__status', { 'is-open': status.open }]} href="/visit" data-hours={JSON.stringify(hours)}>
            <span class="hero__dot" aria-hidden="true"></span>
            <span><span data-status-text>{status.text}</span>{city && <span class="hero__city">, {city}</span>}</span>
          </a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    --rail-h: clamp(360px, calc(100svh - 240px), 660px);   /* garment height on wide screens */
    --hang: 0px;                                            /* premium pass: the rod and hangers are retired, garments sit flush */
    --rod: linear-gradient(90deg, var(--c-zari-deep), var(--c-zari) 30%, var(--c-zari-deep) 65%, var(--c-zari));
    position: relative; isolation: isolate; overflow: hidden;
    /* the boutique wall: sunlit plaster with window light and leaf shadows on the rail's side (public/brand/hero-wall*-v2.webp),
       an ivory wash over the copy side so the text always reads, and a fade into the page at the foot */
    background: var(--c-cream);
    padding-block: clamp(var(--sp-5), 4vh, var(--sp-12));
    --wall: url('/brand/hero-wall-v2.webp') 70% 50% / cover no-repeat;
    --wash:
      linear-gradient(90deg, rgba(251, 247, 244, .6) 0%, rgba(251, 247, 244, .3) 34%, rgba(251, 247, 244, 0) 52%),
      linear-gradient(180deg, rgba(251, 247, 244, 0) 80%, var(--c-cream) 100%),
      linear-gradient(115deg, rgba(247, 235, 221, 0) 40%, rgba(241, 217, 214, .4) 100%);  /* champagne warming to rose on the rail's side */
  }
  /* The living wall: the photo (window light and leaf shadows) drifts very slowly, as if a breeze is moving the
     leaves outside; the readability wash and the fade at the foot stay still above it. */
  .hero::before, .hero::after { content: ''; position: absolute; pointer-events: none; }
  .hero::before { inset: -3%; z-index: -2; background: var(--wall); transform-origin: 70% 20%; }
  .hero::after { inset: 0; z-index: -1; background: var(--wash); }
  @media (prefers-reduced-motion: no-preference) {
    .hero::before { animation: wall-breeze 14s ease-in-out infinite alternate; will-change: transform; }
  }
  @keyframes wall-breeze {
    0% { transform: translate3d(0, 0, 0) skewX(0deg) scale(1.02); }
    45% { transform: translate3d(-0.7%, 0.35%, 0) skewX(-0.9deg) scale(1.035); }
    100% { transform: translate3d(0.5%, -0.25%, 0) skewX(0.6deg) scale(1.025); }
  }
  .hero {
  }

  /* ── wide screens: copy on the left, the rail running off the right edge ── */
  .hero__stage {
    display: grid; column-gap: clamp(var(--sp-8), 5vw, var(--sp-20));
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-rows: 1fr auto auto auto 1fr;
    padding-inline-start: max(var(--layout-gutter), calc((100% - var(--layout-max-width)) / 2 + var(--layout-gutter)));
  }
  .hero__title { grid-column: 1; grid-row: 2; font-size: clamp(2.75rem, 1rem + 4vw, 5.5rem); line-height: .96; letter-spacing: -.02em; font-weight: 500; overflow-wrap: break-word; }
  .hero__line { display: block; }
  .hero__accent { font-style: italic; color: var(--c-accent); letter-spacing: -.01em; }
  .hero__act { grid-column: 1; grid-row: 3; display: grid; gap: var(--sp-6); justify-items: start; margin-top: var(--sp-6); }
  .hero__body { font-size: clamp(1.0625rem, 1rem + .25vw, 1.1875rem); line-height: 1.6; max-width: 34ch; color: var(--c-text); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .hero__foot { grid-column: 1; grid-row: 4; display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-1) var(--sp-6); margin-top: var(--sp-6); }
  .hero__tag { font-size: .9375rem; color: var(--c-ink); }
  .hero__status { display: inline-flex; align-items: center; gap: var(--sp-2); min-height: 44px; font-size: .875rem; color: var(--c-ink); }
  .hero__status:hover [data-status-text] { text-decoration: underline; text-decoration-color: var(--c-zari); text-underline-offset: 3px; }
  .hero__city { color: var(--c-muted); }
  .hero__dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: #B9A79B; }
  .hero__status.is-open .hero__dot { background: var(--c-success); box-shadow: 0 0 0 3px rgba(47, 107, 63, .18); }

  /* ── the rail ── */
  .rail {
    grid-column: 2; grid-row: 1 / -1; display: flex; gap: 10px;
    height: calc(var(--rail-h) + var(--hang)); padding-top: var(--hang);
  }
  .rail__item { position: relative; flex: 1 1 0; min-width: 0; }
  .rail__item::before, .rail__item::after { display: none; } /* premium pass: rings and hooks retired, the rod stays */
  .rail__item::before { /* hanger ring around the rod */
    content: ''; position: absolute; top: calc(-1 * var(--hang) + 4px); left: calc(50% - 6px); width: 12px; height: 12px;
    border: 1.5px solid var(--c-zari-deep); border-radius: 50%;
  }
  .rail__item::after { /* the hook down to the garment */
    content: ''; position: absolute; top: calc(-1 * var(--hang) + 16px); left: calc(50% - .75px); width: 1.5px; height: calc(var(--hang) - 16px); background: var(--c-zari-deep);
  }
  .rail__frame { position: absolute; inset: 0; display: block; overflow: hidden; border-radius: var(--r-img); background: var(--c-sand); box-shadow: var(--shadow-card); }
  .rail__frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 25%; }
  .rail__frame picture { display: contents; }
  .rail__item:last-child .rail__frame { border-start-end-radius: 0; border-end-end-radius: 0; } /* runs off the edge */

  .rail__link::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(0deg, rgba(60, 26, 24, .62), rgba(60, 26, 24, 0) 48%); }
  .rail__link:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 3px; }
  .rail__tag { /* name running up the side, like a garment tag */
    position: absolute; z-index: 1; left: 50%; bottom: 18px; max-height: calc(100% - 36px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    writing-mode: vertical-rl; transform: translateX(-50%) rotate(180deg);
    font-size: .8125rem; font-weight: 500; letter-spacing: .02em; color: #FFFDF8; transition: opacity 260ms ease;
  }
  .rail__cap { position: absolute; z-index: 1; left: 16px; right: 16px; bottom: 14px; display: grid; gap: 2px; color: #FFFDF8; }
  .rail__name { font-size: 1rem; font-weight: 500; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rail__price { font-size: .875rem; font-variant-numeric: tabular-nums; opacity: .9; }

  @media (min-width: 900px) {
    /* the lead photo is open; pointing at a piece pushes it open and closes the others up */
    .rail__item { --open: 5.5; transition: flex-grow 750ms var(--motion-ease-out); }
    .rail__item--lead { flex-grow: var(--open); }
    .rail__item:not(.rail__item--lead):is(:hover, :focus-within) { flex-grow: var(--open); }
    .rail:has(.rail__item:not(.rail__item--lead):is(:hover, :focus-within)) .rail__item--lead { flex-grow: 1; }
    .rail__cap { opacity: 0; transform: translateY(8px); transition: opacity 300ms ease, transform 400ms var(--motion-ease-out); }
    .rail__item:is(:hover, :focus-within) .rail__cap { opacity: 1; transform: none; transition-delay: 220ms; }
    .rail__item:is(:hover, :focus-within) .rail__tag { opacity: 0; }
  }
  @media (min-width: 900px) and (prefers-reduced-motion: reduce) {
    .rail__item, .rail__cap { transition: none; }
  }

  /* Held only while GSAP prepares the entrance (removed by script, or after 1.6s by the head guard). */
  :global(.hero-pending) [data-hero-line] { transform: translateY(105%); }
  :global(.hero-pending) [data-hero-fade] { opacity: 0; }
  :global(.hero-pending) .rail__frame { clip-path: inset(0 0 100% 0); }

  /* ── phones and small tablets: headline, the rail as a swipeable strip, then the buttons ── */
  @media (max-width: 899px) {
    .hero {
      padding-block: var(--sp-6) var(--sp-8);
      --wall: url('/brand/hero-wall-phone-v2.webp') 50% 45% / cover no-repeat;
      --wash: linear-gradient(180deg, rgba(251, 247, 244, .5) 0%, rgba(251, 247, 244, 0) 24%, rgba(251, 247, 244, 0) 76%, var(--c-cream) 100%);
    }
    .hero__stage { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; padding-inline: var(--layout-gutter); }
    .hero__title { grid-row: 1; font-size: clamp(2.25rem, 1.25rem + 4.6vw, 4rem); }
    .rail {
      grid-column: 1; grid-row: 2; height: auto; margin: var(--sp-5) calc(-1 * var(--layout-gutter)) 0;
      padding: var(--hang) var(--layout-gutter) var(--sp-2); gap: 12px;
      overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: var(--layout-gutter);
      background-attachment: local; scrollbar-width: none;
    }
    .rail::-webkit-scrollbar { display: none; }
    .rail__item { flex: 0 0 46vw; height: clamp(300px, 50svh, 460px); scroll-snap-align: start; }
    .rail__item--lead { flex-basis: 72vw; }
    .rail__item:last-child .rail__frame { border-radius: var(--r-img); }
    .rail__tag { display: none; }
    .hero__act { grid-row: 3; margin-top: var(--sp-6); }
    .hero__ctas { order: -1; }
    .hero__foot { grid-row: 4; margin-top: var(--sp-4); }
  }
  @media (max-width: 479px) {
    .hero__act { justify-items: stretch; }
    .hero__ctas { flex-direction: column; }
    .hero__ctas .btn { width: 100%; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { onPage } from '../../lib/lifecycle.ts';

  // Runs every time the home page is shown (first load or client-router navigation back to it).
  onPage(() => {
    const root = document.querySelector<HTMLElement>('[data-hero]');
    const html = document.documentElement;
    if (!root || !html.classList.contains('motion')) { html.classList.remove('hero-pending'); return; }
    const frames = root.querySelectorAll<HTMLElement>('.rail__frame');
    const imgs = root.querySelectorAll<HTMLElement>('.rail__frame img');
    const lines = root.querySelectorAll('[data-hero-line]');
    const fades = root.querySelectorAll('[data-hero-fade]');

    const ctx = gsap.context(() => {
      // Drop the CSS hold first (same frame, no paint) so GSAP doesn't read it as a starting offset.
      html.classList.remove('hero-pending');
      gsap.set(frames, { clipPath: 'inset(0% 0% 100% 0%)' });
      gsap.set(imgs, { scale: 1.15, yPercent: -5 });
      gsap.set(lines, { y: 0, yPercent: 105 });
      gsap.set(fades, { autoAlpha: 0, y: 14 });

      const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
      // The garments drop onto the rail one after another…
      tl.to(frames, { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.1, ease: 'power4.inOut', stagger: 0.09, clearProps: 'clipPath' }, 0)
        .to(imgs, { scale: 1, yPercent: 0, duration: 1.5, ease: 'power3.out', stagger: 0.09, clearProps: 'transform' }, 0.05)
      // …while the headline rises and the rest settles in.
        .to(lines, { yPercent: 0, duration: 1, stagger: 0.1 }, 0.2)
        .to(fades, { autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.08 }, 0.55);
    }, root);

    return () => ctx.revert();
  });
</script>
