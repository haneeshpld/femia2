---
import type { Category, MediaRef } from '@femia/contracts';
import Icon from '../ui/Icon.astro';
import { emph, srcset } from '../../lib/format.ts';
import { t } from '@femia/i18n';
interface Props { heading: string; tiles: { category: Category; image: MediaRef | null }[]; uid?: string }
const { heading, tiles, uid = 'cats' } = Astro.props;
---
<section class="section cats" aria-labelledby={`${uid}-title`}>
  <div class="container">
    <div class="section-head">
      <h2 id={`${uid}-title`} data-split set:html={emph(heading)} />
      <span class="thread-rule" aria-hidden="true"></span>
      <a class="link-arrow" href="/shop">{t('common.viewAll')} <Icon name="arrowRight" size={18} /></a>
    </div>
    <ul role="list" class="cats__track" data-arches>
      {tiles.map(({ category: c, image }) => (
        <li>
          <a href={`/shop/${c.slug}`} class="cat">
            <span class="cat__arch" data-arch-tile>
              {image && <img src={image.src['480']} srcset={srcset(image)} sizes="(min-width: 1024px) 18vw, (min-width: 768px) 30vw, 40vw" width={image.width} height={image.height} alt="" loading="lazy" decoding="async" />}
            </span>
            <span class="cat__base"><span class="cat__name">{c.name}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .cats__track { display: grid; grid-template-columns: repeat(5, 1fr); gap: clamp(var(--sp-4), 2vw, var(--sp-8)); }
  /* Square photo cards; the name sits in small capitals on a soft band below. */
  .cat {
    position: relative; isolation: isolate; display: grid; height: 100%; overflow: hidden;
    border-radius: var(--r-card); background: var(--c-surface); box-shadow: var(--shadow-card); transition: box-shadow 400ms ease;
  }
  .cat::before { content: ''; position: absolute; inset: 0; z-index: 2; border-radius: inherit; border: 1px solid transparent; pointer-events: none; transition: border-color 400ms ease; }
  .cat:hover { box-shadow: var(--shadow-card-hover); }
  .cat:hover::before { border-color: var(--c-zari); }
  .cat__arch { position: relative; display: block; width: 100%; aspect-ratio: 1; overflow: hidden; background: var(--c-sand); }
  .cat__arch img { width: 100%; height: 100%; object-fit: cover; transition: transform 1200ms var(--motion-ease-out); }
  .cat:hover .cat__arch img { transform: scale(1.05); }
  .cat__base { display: grid; place-items: center; min-height: 50px; padding: var(--sp-2) var(--sp-3); background: var(--c-blush); color: var(--c-ink); transition: color var(--motion-fast) ease; }
  .cat__name { font-size: .8125rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; text-align: center; }
  .cat:hover .cat__base { color: var(--c-accent); }
  @media (max-width: 1023px) {
    .cats__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(var(--layout-gutter) * -1); padding: 4px var(--layout-gutter) var(--sp-6); }
    .cats__track::-webkit-scrollbar { display: none; }
    .cats__track li { flex: 0 0 clamp(132px, 34vw, 210px); scroll-snap-align: start; }
    .cat__name { font-size: .75rem; letter-spacing: .1em; }
  }
</style>
