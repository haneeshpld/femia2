{
  "manifestVersion": 1,
  "name": "Femia Storefront",
  "locales": [
    "en"
  ],
  "variantLabels": {
    "option1": "Size",
    "option2": "Colour"
  },
  "imageSizes": [
    480,
    960,
    1600
  ],
  "imageSlots": [
    {
      "id": "product",
      "label": "Product photo (3:4)",
      "aspect": 0.75,
      "minWidth": 1200,
      "mask": "rect"
    },
    {
      "id": "hero",
      "label": "Hero banner · desktop",
      "aspect": 0.9,
      "minWidth": 1400,
      "mask": "rect",
      "hd": true,
      "recommended": {
        "width": 1800,
        "height": 2000
      },
      "help": "Computers (1200 px and wider). Hangs first on the rail of new pieces, beside the headline; keep the outfit centred."
    },
    {
      "id": "heroTablet",
      "label": "Hero banner · tablet",
      "aspect": 0.75,
      "minWidth": 1200,
      "mask": "rect",
      "recommended": {
        "width": 1536,
        "height": 2048
      },
      "help": "Tablets (768 to 1199 px). Hangs first on the rail of new pieces; keep the outfit centred."
    },
    {
      "id": "heroMobile",
      "label": "Hero banner · phone",
      "aspect": 0.6,
      "minWidth": 1080,
      "mask": "rect",
      "recommended": {
        "width": 1080,
        "height": 1800
      },
      "help": "Phones (under 768 px). The first card on the swipeable rail under the headline; keep the outfit centred."
    },
    {
      "id": "arch",
      "label": "Category tile (arch)",
      "aspect": 0.77,
      "minWidth": 800,
      "mask": "arch"
    },
    {
      "id": "occasion",
      "label": "Occasion card",
      "aspect": 1.2,
      "minWidth": 1200,
      "mask": "rect"
    },
    {
      "id": "boutique",
      "label": "Boutique photo (arch)",
      "aspect": 1.4,
      "minWidth": 1200,
      "mask": "arch"
    },
    {
      "id": "social",
      "label": "Instagram post",
      "aspect": 0.95,
      "minWidth": 800,
      "mask": "rect"
    },
    {
      "id": "page",
      "label": "Page banner",
      "aspect": 1.5,
      "minWidth": 1400,
      "mask": "rect"
    },
    {
      "id": "banner",
      "label": "Promo banner · desktop",
      "aspect": 1.6,
      "minWidth": 1400,
      "mask": "rect",
      "hd": true,
      "recommended": {
        "width": 2400,
        "height": 1500
      },
      "help": "Computers (1200 px and wider), beside the message."
    },
    {
      "id": "bannerTablet",
      "label": "Promo banner · tablet",
      "aspect": 1.3333,
      "minWidth": 1200,
      "mask": "rect",
      "recommended": {
        "width": 1600,
        "height": 1200
      },
      "help": "Tablets (768 to 1199 px)."
    },
    {
      "id": "bannerMobile",
      "label": "Promo banner · phone",
      "aspect": 0.8,
      "minWidth": 1080,
      "mask": "rect",
      "recommended": {
        "width": 1080,
        "height": 1350
      },
      "help": "Phones (under 768 px), shown tall above the message."
    }
  ],
  "sections": [
    {
      "id": "announcement",
      "label": "Announcement bar (top of every page)",
      "page": "all",
      "fields": [
        {
          "id": "enabled",
          "type": "boolean",
          "label": "Show the announcement bar"
        },
        {
          "id": "messages",
          "type": "list",
          "label": "Messages",
          "itemLabel": "Message",
          "min": 0,
          "max": 3,
          "fields": [
            {
              "id": "text",
              "type": "text",
              "label": "Text",
              "required": true,
              "maxLength": 80
            },
            {
              "id": "link",
              "type": "url",
              "label": "Link (optional)"
            }
          ]
        }
      ]
    },
    {
      "id": "boutique",
      "label": "Visit us page",
      "page": "visit",
      "fields": [
        {
          "id": "title",
          "type": "text",
          "label": "Heading",
          "maxLength": 40,
          "emphasis": true
        },
        {
          "id": "body",
          "type": "textarea",
          "label": "Text",
          "maxLength": 220
        },
        {
          "id": "image",
          "type": "image",
          "label": "Boutique photo",
          "slot": "boutique"
        }
      ]
    },
    {
      "id": "trust",
      "label": "Our promises (above the footer)",
      "page": "all",
      "fields": [
        {
          "id": "items",
          "type": "list",
          "label": "Promises",
          "itemLabel": "Promise",
          "min": 2,
          "max": 4,
          "fields": [
            {
              "id": "icon",
              "type": "select",
              "label": "Icon",
              "options": [
                {
                  "value": "truck",
                  "label": "Delivery truck"
                },
                {
                  "value": "returns",
                  "label": "Returns"
                },
                {
                  "value": "shield",
                  "label": "Secure"
                },
                {
                  "value": "chat",
                  "label": "Chat"
                },
                {
                  "value": "heart",
                  "label": "Heart"
                }
              ]
            },
            {
              "id": "title",
              "type": "text",
              "label": "Title",
              "required": true,
              "maxLength": 24
            },
            {
              "id": "body",
              "type": "text",
              "label": "Detail",
              "maxLength": 30
            }
          ]
        }
      ]
    },
    {
      "id": "newsletter",
      "label": "Newsletter sign-up (in the footer)",
      "page": "all",
      "fields": [
        {
          "id": "title",
          "type": "text",
          "label": "Heading",
          "maxLength": 40
        },
        {
          "id": "body",
          "type": "text",
          "label": "Text",
          "maxLength": 90
        }
      ]
    },
    {
      "id": "about",
      "label": "Our story page",
      "page": "about",
      "fields": [
        {
          "id": "title",
          "type": "text",
          "label": "Heading",
          "required": true,
          "maxLength": 60
        },
        {
          "id": "intro",
          "type": "textarea",
          "label": "Intro",
          "maxLength": 300
        },
        {
          "id": "body",
          "type": "richtext",
          "label": "Story",
          "maxLength": 4000
        },
        {
          "id": "image",
          "type": "image",
          "label": "Photo",
          "slot": "page"
        }
      ]
    },
    {
      "id": "policies",
      "label": "Policy pages",
      "page": "policies",
      "fields": [
        {
          "id": "shipping",
          "type": "richtext",
          "label": "Shipping policy",
          "required": true,
          "maxLength": 8000
        },
        {
          "id": "returns",
          "type": "richtext",
          "label": "Returns & exchanges",
          "required": true,
          "maxLength": 8000
        },
        {
          "id": "privacy",
          "type": "richtext",
          "label": "Privacy policy",
          "required": true,
          "maxLength": 12000
        },
        {
          "id": "terms",
          "type": "richtext",
          "label": "Terms of service",
          "required": true,
          "maxLength": 12000
        },
        {
          "id": "contact",
          "type": "richtext",
          "label": "Contact",
          "required": true,
          "maxLength": 2000
        }
      ]
    },
    {
      "id": "sizeGuide",
      "label": "Size guide",
      "page": "product",
      "fields": [
        {
          "id": "chart",
          "type": "richtext",
          "label": "Default size chart (markdown table)",
          "maxLength": 3000
        },
        {
          "id": "howToMeasure",
          "type": "textarea",
          "label": "How to measure",
          "maxLength": 600
        }
      ]
    }
  ],
  "flags": {
    "wishlist": true,
    "search": true,
    "whatsappOrder": true
  },
  "blocks": [
    {
      "type": "hero",
      "label": "Main banner",
      "description": "The first thing shoppers see: your headline, two buttons and the main photo, with a few pieces hanging beside it.",
      "single": true,
      "pinned": "first",
      "defaults": {
        "title": "Everyday Styles for",
        "titleAccent": "Modern Women",
        "ctaLabel": "Shop New Arrivals",
        "ctaLink": "/shop?sort=new",
        "railSource": "newest"
      },
      "fields": [
        {
          "id": "title",
          "type": "text",
          "label": "Headline, first line",
          "required": true,
          "maxLength": 40
        },
        {
          "id": "titleAccent",
          "type": "text",
          "label": "Headline, second line (in italics)",
          "maxLength": 30
        },
        {
          "id": "body",
          "type": "textarea",
          "label": "A sentence under the headline",
          "maxLength": 160
        },
        {
          "id": "ctaLabel",
          "type": "text",
          "label": "Main button text",
          "required": true,
          "maxLength": 24
        },
        {
          "id": "ctaLink",
          "type": "url",
          "label": "Main button opens",
          "required": true
        },
        {
          "id": "secondaryLabel",
          "type": "text",
          "label": "Second button text",
          "maxLength": 24
        },
        {
          "id": "secondaryLink",
          "type": "url",
          "label": "Second button opens"
        },
        {
          "id": "image",
          "type": "image",
          "label": "Main photo",
          "slot": "hero"
        },
        {
          "id": "imageTablet",
          "type": "image",
          "label": "Tablet photo",
          "slot": "heroTablet",
          "help": "Leave empty to use the desktop photo on tablets.",
          "group": "Use a different photo on tablets or phones"
        },
        {
          "id": "imageMobile",
          "type": "image",
          "label": "Phone photo",
          "slot": "heroMobile",
          "help": "Leave empty to use the tablet or desktop photo on phones.",
          "group": "Use a different photo on tablets or phones"
        },
        {
          "id": "railSource",
          "type": "select",
          "label": "Pieces hanging beside the photo",
          "options": [
            {
              "value": "newest",
              "label": "Newest arrivals"
            },
            {
              "value": "popular",
              "label": "Most popular"
            },
            {
              "value": "collection",
              "label": "A collection"
            },
            {
              "value": "category",
              "label": "A category"
            }
          ],
          "help": "Up to four pieces that are in stock."
        },
        {
          "id": "railCollection",
          "type": "collection",
          "label": "Which collection",
          "showIf": {
            "field": "railSource",
            "in": [
              "collection"
            ]
          }
        },
        {
          "id": "railCategory",
          "type": "category",
          "label": "Which category",
          "showIf": {
            "field": "railSource",
            "in": [
              "category"
            ]
          }
        },
        {
          "id": "eyebrow",
          "type": "text",
          "label": "Small line under the buttons (optional)",
          "maxLength": 40
        }
      ],
      "note": "The open / closed line under the buttons uses the opening hours in Settings → Store."
    },
    {
      "type": "categories",
      "label": "Shop by category",
      "description": "Your categories as swing tags hanging on a gold thread. Leave the list empty to show every category.",
      "defaults": {
        "heading": "Shop by *category*",
        "items": []
      },
      "fields": [
        {
          "id": "heading",
          "type": "text",
          "label": "Heading",
          "maxLength": 40,
          "emphasis": true
        },
        {
          "id": "items",
          "type": "list",
          "label": "Category tags",
          "itemLabel": "Tag",
          "min": 0,
          "max": 8,
          "fields": [
            {
              "id": "category",
              "type": "category",
              "label": "Category",
              "required": true
            },
            {
              "id": "image",
              "type": "image",
              "label": "Photo (optional: uses the category photo otherwise)",
              "slot": "arch"
            }
          ]
        }
      ]
    },
    {
      "type": "products",
      "label": "Row of products",
      "description": "A row of products: your newest arrivals, the most popular, a collection or a category. Add as many rows as you like.",
      "defaults": {
        "heading": "Just *landed*",
        "linkLabel": "View all",
        "source": "newest",
        "count": 4
      },
      "fields": [
        {
          "id": "heading",
          "type": "text",
          "label": "Heading",
          "maxLength": 40,
          "emphasis": true
        },
        {
          "id": "linkLabel",
          "type": "text",
          "label": "Link text beside the heading",
          "help": "For example: All new arrivals",
          "maxLength": 30
        },
        {
          "id": "source",
          "type": "select",
          "label": "Show",
          "options": [
            {
              "value": "newest",
              "label": "Newest arrivals"
            },
            {
              "value": "collection",
              "label": "A collection"
            },
            {
              "value": "category",
              "label": "A category"
            },
            {
              "value": "popular",
              "label": "Most popular"
            }
          ]
        },
        {
          "id": "collection",
          "type": "collection",
          "label": "Which collection",
          "showIf": {
            "field": "source",
            "in": [
              "collection"
            ]
          }
        },
        {
          "id": "category",
          "type": "category",
          "label": "Which category",
          "showIf": {
            "field": "source",
            "in": [
              "category"
            ]
          }
        },
        {
          "id": "count",
          "type": "number",
          "label": "How many",
          "choices": [
            {
              "value": 4,
              "label": "4 (one row)"
            },
            {
              "value": 8,
              "label": "8 (two rows)"
            },
            {
              "value": 12,
              "label": "12 (three rows)"
            }
          ]
        }
      ]
    },
    {
      "type": "occasions",
      "label": "Shop by occasion",
      "description": "Photo cards for occasions such as Everyday, Festive and Work, each opening a collection.",
      "defaults": {
        "heading": "Dressed for every *moment*",
        "items": []
      },
      "fields": [
        {
          "id": "heading",
          "type": "text",
          "label": "Heading",
          "maxLength": 40,
          "emphasis": true
        },
        {
          "id": "items",
          "type": "list",
          "label": "Occasion cards",
          "itemLabel": "Card",
          "min": 0,
          "max": 6,
          "fields": [
            {
              "id": "collection",
              "type": "collection",
              "label": "Collection",
              "required": true
            },
            {
              "id": "title",
              "type": "text",
              "label": "Card title",
              "required": true,
              "maxLength": 30
            },
            {
              "id": "image",
              "type": "image",
              "label": "Photo",
              "slot": "occasion"
            }
          ]
        }
      ]
    },
    {
      "type": "boutique",
      "label": "Visit our boutique",
      "description": "Your shop photo and a short welcome, with the address, opening hours, directions and WhatsApp.",
      "defaults": {
        "heading": "Try it on *in person*",
        "body": "Step into our boutique to explore the full collection, feel the fabrics and find your perfect fit."
      },
      "fields": [
        {
          "id": "heading",
          "type": "text",
          "label": "Heading",
          "maxLength": 40,
          "emphasis": true
        },
        {
          "id": "body",
          "type": "textarea",
          "label": "Welcome text",
          "maxLength": 220
        },
        {
          "id": "image",
          "type": "image",
          "label": "Boutique photo",
          "slot": "boutique"
        }
      ],
      "note": "The address, opening hours, map link and WhatsApp number come from Settings → Store."
    },
    {
      "type": "instagram",
      "label": "Photo wall",
      "description": "Up to 8 photos of customers or looks, laid out like prints on a table around your heading.",
      "defaults": {
        "heading": "Styled *by you*",
        "handle": "@femia__boutique",
        "images": []
      },
      "fields": [
        {
          "id": "heading",
          "type": "text",
          "label": "Heading",
          "maxLength": 40,
          "emphasis": true
        },
        {
          "id": "handle",
          "type": "text",
          "label": "Instagram handle (optional)",
          "maxLength": 40,
          "help": "For example @femia__boutique"
        },
        {
          "id": "images",
          "type": "list",
          "label": "Photos",
          "itemLabel": "Photo",
          "min": 0,
          "max": 8,
          "fields": [
            {
              "id": "image",
              "type": "image",
              "label": "Photo",
              "slot": "social",
              "required": true
            },
            {
              "id": "caption",
              "type": "text",
              "label": "Caption on the print (optional)",
              "maxLength": 40
            },
            {
              "id": "link",
              "type": "url",
              "label": "Post link (optional)"
            }
          ]
        }
      ],
      "note": "Leave the Instagram handle empty to use the Instagram link in Settings → Store."
    },
    {
      "type": "banner",
      "label": "Promo banner",
      "description": "A wide photo with a short message and a button: for a sale, a launch or a festival.",
      "defaults": {
        "heading": "The Festive Edit",
        "ctaLabel": "Shop now",
        "ctaLink": "/collections",
        "align": "left"
      },
      "fields": [
        {
          "id": "heading",
          "type": "text",
          "label": "Heading",
          "required": true,
          "maxLength": 50,
          "emphasis": true
        },
        {
          "id": "body",
          "type": "textarea",
          "label": "Message",
          "maxLength": 180
        },
        {
          "id": "ctaLabel",
          "type": "text",
          "label": "Button text",
          "maxLength": 24
        },
        {
          "id": "ctaLink",
          "type": "url",
          "label": "Button opens"
        },
        {
          "id": "image",
          "type": "image",
          "label": "Photo",
          "slot": "banner"
        },
        {
          "id": "imageTablet",
          "type": "image",
          "label": "Tablet photo",
          "slot": "bannerTablet",
          "help": "Leave empty to use the desktop photo on tablets.",
          "group": "Use a different photo on tablets or phones"
        },
        {
          "id": "imageMobile",
          "type": "image",
          "label": "Phone photo",
          "slot": "bannerMobile",
          "help": "Leave empty to use the tablet or desktop photo on phones.",
          "group": "Use a different photo on tablets or phones"
        },
        {
          "id": "align",
          "type": "select",
          "label": "Message on the",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        }
      ]
    },
    {
      "type": "story",
      "label": "A few words about us",
      "description": "A short paragraph about Femia in the middle of the page, with an optional link.",
      "defaults": {
        "heading": "Made for the way you live",
        "linkLabel": "Our story",
        "link": "/about"
      },
      "fields": [
        {
          "id": "heading",
          "type": "text",
          "label": "Heading",
          "maxLength": 60,
          "emphasis": true
        },
        {
          "id": "body",
          "type": "textarea",
          "label": "Text",
          "maxLength": 420
        },
        {
          "id": "linkLabel",
          "type": "text",
          "label": "Link text (optional)",
          "maxLength": 30
        },
        {
          "id": "link",
          "type": "url",
          "label": "Link opens"
        }
      ]
    }
  ]
}
